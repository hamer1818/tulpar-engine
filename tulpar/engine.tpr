// ============================================
// Tulpar Engine — motor köprüsü (engine/, C++ çekirdek; oyun mantığı Tulpar'da)
//
// Native katman: aot_eng_* builtin'leri (runtime/engine_bindings.cpp, ÜRETİLMİŞ:
// engine/tools/gen_engine_bindings.py) -> engine/bridge/engine_api.h (teng_*).
// Bu dosya o katmanın üstündeki ergonomik sarmalayıcıdır: kısa TR/EN adlar,
// renkler, küçük yardımcılar. `import "engine"` eden program otomatik olarak
// libtulpar_engine.a + motor arşivleriyle linklenir; motoru kullanmayan
// binary'ler Vulkan/pencere bağımlılığı almaz (zaten dlopen).
//
// Kullanım:
//   import "engine";
//   motor_ac("Oyunum", 1280, 720);
//   int zemin = zemin_kur(20, GRI);
//   int top = kure(0, 5, 0, 0.5, true, KIRMIZI);
//   while (calisiyor()) {
//       kare_basla();
//       if (tus("SPACE")) { itme(top, 0, 5, 0); }
//       yazi("merhaba", 20, 20, 1, BEYAZ);
//       kare_bitir();
//   }
//   motor_kapat();
//
// Loglama: TULPAR_ENGINE_LOG=0..3 (3 = her çağrı), betikten `logla("...")` (log() doğal logaritmadır).
// Pencersiz: TULPAR_ENGINE_HEADLESS=N (N kare) + TULPAR_ENGINE_OUT=x.ppm.
// Renkler paketlenmiş int: (r<<24)|(g<<16)|(b<<8)|a — onaltılık literal yok, renk(r,g,b) kullan.
// ============================================

// ---- Renkler ----------------------------------------------------------------
// Onaltilik literal yok (lexer): degerler ondalik, yorumda r,g,b. rgb icin renk(r,g,b).
int BEYAZ = 4294967295;  int WHITE_E = 4294967295;   // 255,255,255
int SIYAH = 255;  int BLACK_E = 255;   // 0,0,0
int KIRMIZI = 3862513407;  int RED_E = 3862513407;   // 230,57,70
int YESIL = 714969087;  int GREEN_E = 714969087;   // 42,157,143
int MAVI = 1165729279;  int BLUE_E = 1165729279;   // 69,123,157
int SARI = 4107493119;  int YELLOW_E = 4107493119;   // 244,211,94
int TURUNCU = 4152295679;  int ORANGE_E = 4152295679;   // 247,127,0
int MOR = 2386865663;  int PURPLE_E = 2386865663;   // 142,68,173
int GRI = 2594219775;  int GRAY_E = 2594219775;   // 154,160,166
int ACIK_GRI = 3470056191;   // 206,212,218
int KOYU = 572926975;   // 34,38,43
int SEFFAF_SIYAH = 120;   // 0,0,0,120

// Bit kaydirma operatoru YOK (lexer): tame'in rgb()'siyle ayni carpma bicimi.
func renk(r, g, b): int { return r * 16777216 + g * 65536 + b * 256 + 255; }
func renk_a(r, g, b, a): int { return r * 16777216 + g * 65536 + b * 256 + a; }

// ---- Yaşam döngüsü ----------------------------------------------------------
func motor_ac(baslik, w, h): bool { return eng_init(baslik, w, h); }
func engine_open(title, w, h): bool { return eng_init(title, w, h); }
func calisiyor(): bool { return eng_running(); }
func running_e(): bool { return eng_running(); }
func motor_kapat() { eng_shutdown(); }
func engine_close() { eng_shutdown(); }
func cikis_iste() { eng_close(); }
func kare_basla(): bool { return eng_frame_begin(); }
func kare_bitir() { eng_frame_end(); }
func frame_begin_e(): bool { return eng_frame_begin(); }
func frame_end_e() { eng_frame_end(); }
func dt(): float { return eng_dt(); }
func zaman(): float { return eng_time(); }
func kare_no(): int { return eng_frame(); }
func fps_e(): float { return eng_fps(); }
func genislik(): int { return eng_width(); }
func yukseklik(): int { return eng_height(); }
func logla(msg) { eng_log(msg); }
func engine_log(msg) { eng_log(msg); }
func log_seviyesi(n) { eng_log_level(n); }
func pencersiz(kare, cikti) { eng_set_headless(kare, cikti); }
func hata_sayisi(): int { return eng_error_count(); }
func uyari_sayisi(): int { return eng_warning_count(); }
func ekran_goruntusu(yol): bool { return eng_screenshot(yol); }

// ---- Dünya / kamera ---------------------------------------------------------
func yercekimi(gx, gy, gz) { eng_gravity(gx, gy, gz); }
func gunes(dx, dy, dz, siddet) { eng_sun(dx, dy, dz, siddet); }
func ortam(renk_) { eng_ambient(renk_); }
func golge_hacmi(cx, cy, cz, r, d) { eng_shadow_volume(cx, cy, cz, r, d); }
// Parlama (bloom): motor_ac'tan ONCE cagir. Esik dogrusal parlaklik (1.0 =
// yalniz cok parlak yerler yayilir), yogunluk 0 = kapali.
func parlama(ac, esik, yogunluk) { eng_bloom(ac, esik, yogunluk); }
func bloom(on, threshold, intensity) { eng_bloom(on, threshold, intensity); }
func parlama_acik(): bool { return eng_bloom_on(); }
func kamera(ex, ey, ez, tx, ty, tz) { eng_camera(ex, ey, ez, tx, ty, tz); }
func kamera_yorunge(tx, ty, tz, yaw, pitch, uzaklik) { eng_camera_orbit(tx, ty, tz, yaw, pitch, uzaklik); }
func camera(ex, ey, ez, tx, ty, tz) { eng_camera(ex, ey, ez, tx, ty, tz); }
// Kamera hedefi takip etsin: hedefin arkasında/üstünde (yaw radyan).
func kamera_takip(tx, ty, tz, uzaklik, yukseklik_, yaw) {
    eng_camera(tx + sin(yaw) * uzaklik, ty + yukseklik_, tz + cos(yaw) * uzaklik, tx, ty, tz);
}

// ---- Sahne (.sahneb) --------------------------------------------------------
func sahne_yukle(yol): bool { return eng_scene_load(yol); }
func scene_load(path): bool { return eng_scene_load(path); }
func sahne_bul(ad): int { return eng_scene_find(ad); }
func sahne_adi(i): str { return eng_scene_name(i); }
// Varlığa editörde atanmış .tpr yolu. Motor bu betiği kendisi ÇALIŞTIRIR
// (<ad>_baslat/_guncelle/_carpisma/_bitir, bkz. docs/KOPRU.md 7.9); bu erişimci
// yolu OKUMAK isteyen oyun için. Yüklemede BİR KEZ okuyun: her çağrı VM'de
// yeni bir metin ayırıyor.
func sahne_betik(i): str { return eng_scene_script(i); }
// "Atanmamış" ile "atanmış ama kapalı" AYRI: ikincisinde yol yine okunur.
func sahne_betik_etkin(i): bool { return eng_scene_script_enabled(i); }
func sahne_sayisi(): int { return eng_scene_count(); }
func sahne_x(i): float { return eng_scene_x(i); }
func sahne_y(i): float { return eng_scene_y(i); }
func sahne_z(i): float { return eng_scene_z(i); }
func sahne_hiz_x(i): float { return eng_scene_vx(i); }
func sahne_hiz_y(i): float { return eng_scene_vy(i); }
func sahne_hiz_z(i): float { return eng_scene_vz(i); }
func sahne_dinamik(i): bool { return eng_scene_is_dynamic(i); }
func sahne_hiz_ver(i, vx, vy, vz) { eng_scene_set_velocity(i, vx, vy, vz); }
func sahne_itme(i, ix, iy, iz) { eng_scene_impulse(i, ix, iy, iz); }
func scene_impulse(i, ix, iy, iz) { eng_scene_impulse(i, ix, iy, iz); }
// Sahne karakteri: editörde "Karakter Kontrolcüsü" bileşeni olan varlık sahne
// yüklenince karakter olarak doğar (aynı varlıktaki gövde bileşeni doğurulmaz,
// karakter onun yerini alır). Kapsül yazar konumuna ORTALI: sahne_y(i) MERKEZ
// (koddan üretilen `karakter`de konum ayak tabanı). `sahne_hiz_ver`/`sahne_itme`
// karakterde HATA verir — hızı `sahne_karakter_yuru` verir; istek KALICI.
func sahne_karakter_mi(i): bool { return eng_scene_is_character(i); }
func scene_is_character(i): bool { return eng_scene_is_character(i); }
func sahne_karakter_yuru(i, vx, vz, zipla) { eng_scene_character_move(i, vx, vz, zipla); }
func scene_character_move(i, vx, vz, jump) { eng_scene_character_move(i, vx, vz, jump); }
func sahne_karakter_yerde(i): bool { return eng_scene_character_grounded(i); }
func scene_character_grounded(i): bool { return eng_scene_character_grounded(i); }
func sahne_karakter_ziplama(i, hiz) { eng_scene_character_set_jump(i, hiz); }
func scene_character_set_jump(i, speed) { eng_scene_character_set_jump(i, speed); }
// Bolum gecisi: once bosalt (govdeler fizikten cikar), sonra yenisini yukle.
func sahne_bosalt(): bool { return eng_scene_unload(); }
func scene_unload(): bool { return eng_scene_unload(); }
func sahne_yuklu(): bool { return eng_scene_loaded(); }
func bolum_gec(yol): bool {
    if (eng_scene_loaded()) { eng_scene_unload(); }
    return eng_scene_load(yol);
}
func next_level(path): bool { return bolum_gec(path); }

// ---- Varlıklar --------------------------------------------------------------
func kutu(x, y, z, hx, hy, hz, dinamik, renk_): int { return eng_spawn_box(x, y, z, hx, hy, hz, dinamik, renk_); }
func box(x, y, z, hx, hy, hz, dynamic, color): int { return eng_spawn_box(x, y, z, hx, hy, hz, dynamic, color); }
func kure(x, y, z, r, dinamik, renk_): int { return eng_spawn_sphere(x, y, z, r, dinamik, renk_); }
func sphere(x, y, z, r, dynamic, color): int { return eng_spawn_sphere(x, y, z, r, dynamic, color); }
func zemin_kur(yarim, renk_): int { return eng_spawn_ground(yarim, renk_); }
func ground(half, color): int { return eng_spawn_ground(half, color); }
// Tetik (bölge): GÖRÜNMEZ, çarpışma tepkisi yok, içinden geçilir. Giren/çıkan
// gövdeler `tetik_olay_*` kuyruğunda. `isinla(id, x, y, z)` tetiği TAŞIR —
// içeride duran gövde için sahte "girdi" üretmez.
func tetik_kutu(x, y, z, hx, hy, hz): int { return eng_spawn_trigger_box(x, y, z, hx, hy, hz); }
func trigger_box(x, y, z, hx, hy, hz): int { return eng_spawn_trigger_box(x, y, z, hx, hy, hz); }
func tetik_kure(x, y, z, r): int { return eng_spawn_trigger_sphere(x, y, z, r); }
func trigger_sphere(x, y, z, r): int { return eng_spawn_trigger_sphere(x, y, z, r); }
// Karakter denetleyicisi: sanal kapsül — rampada kaymaz, 0.4 m basamak çıkar,
// zemine yapışır, dinamik gövdeleri iter. Konum AYAK tabanı (konum_y = ayak).
// `karakter_yuru` isteği KALICI: durdurmak için (id, 0, 0, false). Dikey hız
// motorun: yerçekimi + zıplama. `itme`/`hiz_ver` karakterde HATA verir.
// `konum_*`, `isinla`, `sil`, `en_yakin`, ışın ve tetikler karakterde de çalışır.
