// ---- Kodla üretilen varlığa betik bağlama -------------------------------------
// Sahnedeki `betik "davranis/x.tpr"` atamasının KOD ikizi: oyun düşmanı kendi
// dizisinde tutup her karede elle dolaşmaz, davranışı bağlar ve bırakır.
//
//     int d = kure(x, 0.5, z, 0.4, true, KIRMIZI);
//     betik_ata(d, "dusman");       // ya da "davranis/dusman.tpr" — taban ad
//
// Motor `dusman_*` kancalarını SAHNE kancalarıyla aynı yerde çağırır (kare
// sonunda, fizikten sonra: tetik -> çarpışma -> güncelle; yuva sırası):
//   dusman_baslat(id)                                     bağlanınca, hemen
//   dusman_guncelle(id, dt)                               her kare
//   dusman_carpisma(id, diger, olay, x, y, z, hiz, diger_sahne)
//   dusman_tetik_girdi / _cikti(id, diger, diger_sahne)   varlık bir TETİKse
//   dusman_bolge_girdi / _cikti(id, bolge, bolge_sahne)   varlık bir tetiğe girdi/çıktı
//   dusman_bitir(id)                                      betik_kaldir / sil / yeniden bağla / kapanış
// `id`, `diger`, `bolge` KÖPRÜ id'si (0 = köprü varlığı değil); son argüman
// aynı tarafın SAHNE dizini (-1 = değil) ve isteğe bağlı (yazılmayabilir).
// İkinci `betik_ata` öncekinin YERİNE geçer: önce onun `_bitir`i, sonra
// yeninin `_baslat`ı. Kancası bulunamayan ad (import edilmemiş dosya) HATA
// basar ve false döner. Betik değişkenleri varlık başına DEĞİL, betik başına.
func betik_ata(id, ad): bool { return eng_script_attach(id, ad); }
func script_attach(id, name): bool { return eng_script_attach(id, name); }
func betik_kaldir(id): bool { return eng_script_detach(id); }
func script_detach(id): bool { return eng_script_detach(id); }
func betik_adi(id): str { return eng_script_name(id); }
func script_name(id): str { return eng_script_name(id); }
func betikli_sayisi(): int { return eng_script_count(); }
func script_count(): int { return eng_script_count(); }

// ---- Vektör: dilin kutusuz struct'ı -------------------------------------------
// Konum, hız ve yön TEK değer olarak taşınır. Eskiden oyun kodu bileşenleri
// tek tek okuyup ayrı değişkenlerde tutuyordu (engine_aksiyon.tpr: 27 satır
// yalnız konum_x/y/z, 17 satır elle sin/cos/sqrt). `Vec3` Tulpar'ın KUTUSUZ
// struct'ı: üç double, yığın ayırması yok, alan erişimi doğrudan.
// XZ yardımcıları yatay düzlemdir (yerçekimi Y): yürüme, bakış, mesafe.
struct Vec3 { float x; float y; float z; }
func v3(float x, float y, float z): Vec3 { return { x: x, y: y, z: z }; }
func konum(int id): Vec3 { return { x: eng_x(id), y: eng_y(id), z: eng_z(id) }; }
func position(int id): Vec3 { return konum(id); }
func sahne_konum(int i): Vec3 { return { x: eng_scene_x(i), y: eng_scene_y(i), z: eng_scene_z(i) }; }
func v_topla(Vec3 a, Vec3 b): Vec3 { return { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z }; }
func v_fark(Vec3 a, Vec3 b): Vec3 { return { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z }; }
func v_olcek(Vec3 a, float s): Vec3 { return { x: a.x * s, y: a.y * s, z: a.z * s }; }
// Yatay uzaklık (a'dan b'ye).
func uzaklik_xz(Vec3 a, Vec3 b): float {
    float dx = b.x - a.x;
    float dz = b.z - a.z;
    return sqrt(dx * dx + dz * dz);
}
func distance_xz(Vec3 a, Vec3 b): float { return uzaklik_xz(a, b); }
// a'dan b'ye YATAY birim yön. Çok yakınsa (1 mm) sıfır DEĞİL, `yedek` döner:
// bölme sıfıra düşmesin ve çağıran "hangi yöne" sorusunu kendisi cevaplasın.
func yon_xz(Vec3 a, Vec3 b, Vec3 yedek): Vec3 {
    float dx = b.x - a.x;
    float dz = b.z - a.z;
    float uz = sqrt(dx * dx + dz * dz);
    if (uz < 0.001) { return yedek; }
    return { x: dx / uz, y: 0.0, z: dz / uz };
}
// Yatay vektörü birim boya getir; sıfıra yakınsa olduğu gibi döner.
func normal_xz(Vec3 v): Vec3 {
    float uz = sqrt(v.x * v.x + v.z * v.z);
    if (uz <= 0.001) { return v; }
    return { x: v.x / uz, y: 0.0, z: v.z / uz };
}
func uzunluk_xz(Vec3 v): float { return sqrt(v.x * v.x + v.z * v.z); }
// Yaw (radyan) <-> ileri yön. Motorun kuralı: yaw 0 -Z'ye bakar.
func yaw_yonu(float yaw): Vec3 { return { x: 0.0 - sin(yaw), y: 0.0, z: 0.0 - cos(yaw) }; }
func yon_yaw(Vec3 v): float { return atan2(0.0 - v.x, 0.0 - v.z); }
// Kameraya göre hareket: girdi (sağ, ileri) -> dünya yönü (yatay).
func kameraya_gore(float kam_yaw, float sag, float ileri): Vec3 {
    return { x: cos(kam_yaw) * sag + (0.0 - sin(kam_yaw)) * ileri, y: 0.0,
             z: (0.0 - sin(kam_yaw)) * sag + (0.0 - cos(kam_yaw)) * ileri };
}
func isinla_v(int id, Vec3 p) { eng_set_pos(id, p.x, p.y, p.z); }
func itme_v(int id, Vec3 v) { eng_impulse(id, v.x, v.y, v.z); }
// Yatay hız ver, dikey hızı (düşüş, zıplama) KORU: `yuru`nun vektör ikizi.
func yuru_v(int id, Vec3 v) { eng_set_velocity(id, v.x, eng_vy(id), v.z); }

// ---- Sorgular: ışın testi ve yakınlık ---------------------------------------
// Köprüde çarpışma OLAYI yok (callback FFI yok); savaş ve yapay zekâ bu iki
// SORGU ile yazılır: "önümde ne var" (ışın) ve "yakınımda kim var" (küre).
// Işın testi gövdeler eklendikten sonra EN AZ BİR kare ister (geniş faz).
func isin(ox, oy, oz, dx, dy, dz, uzaklik, atla): float { return eng_raycast(ox, oy, oz, dx, dy, dz, uzaklik, atla); }
func raycast(ox, oy, oz, dx, dy, dz, max_dist, skip): float { return eng_raycast(ox, oy, oz, dx, dy, dz, max_dist, skip); }
func isin_x(): float { return eng_ray_x(); }
func isin_y(): float { return eng_ray_y(); }
func isin_z(): float { return eng_ray_z(); }
func isin_nx(): float { return eng_ray_nx(); }
func isin_ny(): float { return eng_ray_ny(); }
func isin_nz(): float { return eng_ray_nz(); }
func isin_id(): int { return eng_ray_id(); }
func isin_sahne(): int { return eng_ray_scene(); }
func ray_x(): float { return eng_ray_x(); }
func ray_y(): float { return eng_ray_y(); }
func ray_z(): float { return eng_ray_z(); }
func ray_id(): int { return eng_ray_id(); }
func yakinlar(x, y, z, r, atla): int { return eng_overlap(x, y, z, r, atla); }
func overlap(x, y, z, r, skip): int { return eng_overlap(x, y, z, r, skip); }
func yakin_id(i): int { return eng_overlap_id(i); }
func overlap_id(i): int { return eng_overlap_id(i); }
func yakin_uzaklik(i): float { return eng_overlap_dist(i); }
func overlap_dist(i): float { return eng_overlap_dist(i); }
func en_yakin(x, y, z, r, atla): int { return eng_nearest(x, y, z, r, atla); }
func nearest(x, y, z, r, skip): int { return eng_nearest(x, y, z, r, skip); }

// ---- Çarpışma olayları ------------------------------------------------------
// Motor geri çağrım (callback) veremiyor — bugünkü FFI onu taşımıyor. Onun
// yerine KUYRUK: fizik adımında oluşan temaslar halkaya yazılır, oyun karede
// okur. Tipik kullanım:
//
//     int n = carpisma_sayisi();
//     for (int i = 0; i < n; i = i + 1) {
//         if (carpisma_siddeti(i) > 5.0) { hasar_ver(carpisma_a(i)); }
//     }
//
// `carpisma_dusen()` 0 değilse halka dolmuş ve olay KAYBEDİLMİŞ demektir;
// sessizce kırpılmıyor, motor da her karede bir kez hata logluyor.
func carpisma_sayisi(): int { return eng_collision_count(); }
func collision_count(): int { return eng_collision_count(); }
func carpisma_dusen(): int { return eng_collision_dropped(); }
func collision_dropped(): int { return eng_collision_dropped(); }
func carpisma_a(i): int { return eng_collision_a(i); }
func collision_a(i): int { return eng_collision_a(i); }
func carpisma_b(i): int { return eng_collision_b(i); }
func collision_b(i): int { return eng_collision_b(i); }
func carpisma_sahne_a(i): int { return eng_collision_scene_a(i); }
