// ---- Tetik olayları (kuyruk) --------------------------------------------------
// Bu karede bir tetik hacmine GİREN ve ÇIKAN gövdeler, belirlenimli sırada.
// Koddan üretilen (`tetik_kutu`) ve sahnede tanımlanan tetiklerin ikisi de.
//
//     int n = tetik_olay_sayisi();
//     for (int i = 0; i < n; i = i + 1) {
//         if (tetik_olay_bolge(i) == kapi && tetik_olay_diger(i) == oyuncu && tetik_olay_girdi(i)) { kapiyi_ac(); }
//     }
//
// Sahne tetiklerine betik atandıysa `<ad>_tetik_girdi` kancaları AYRICA çalışır.
func tetik_olay_sayisi(): int { return eng_trigger_count(); }
func trigger_event_count(): int { return eng_trigger_count(); }
func tetik_olay_dusen(): int { return eng_trigger_dropped(); }
func trigger_event_dropped(): int { return eng_trigger_dropped(); }
func tetik_olay_bolge(i): int { return eng_trigger_zone(i); }
func trigger_event_zone(i): int { return eng_trigger_zone(i); }
func tetik_olay_bolge_sahne(i): int { return eng_trigger_zone_scene(i); }
func trigger_event_zone_scene(i): int { return eng_trigger_zone_scene(i); }
func tetik_olay_diger(i): int { return eng_trigger_other(i); }
func trigger_event_other(i): int { return eng_trigger_other(i); }
func tetik_olay_diger_sahne(i): int { return eng_trigger_other_scene(i); }
func trigger_event_other_scene(i): int { return eng_trigger_other_scene(i); }
func tetik_olay_girdi(i): bool { return eng_trigger_entered(i); }
func trigger_event_entered(i): bool { return eng_trigger_entered(i); }

// Yerde mi — ışınla: varlığın ALTINDAN (merkez - `alt`) aşağı `mesafe` kadar
// ışın atar. `yerde()`nin dikey hız tahmininden sağlamdır (kutu üstünde
// duruyorken de doğru). `alt` gövdenin yarı yüksekliği + küçük pay olmalı ki
// ışın kendi gövdesinin DIŞINDAN başlasın (içeriden başlarsa Jolt mesafe 0
// verir ve köprü gövdeyi komple atlamak zorunda kalır).
func yerde_isin(id, alt, mesafe): bool { return eng_raycast(eng_x(id), eng_y(id) - alt, eng_z(id), 0, -1, 0, mesafe, id) >= 0.0; }
func grounded(id, below, dist): bool { return yerde_isin(id, below, dist); }

// Görüş hattı: kaynaktan hedefe ışın; ilk çarptığı HEDEFİN kendisiyse görüş
// açıktır (arada duvar varsa ışın ona takılır ve id tutmaz).
func gorus_var(kaynak, hedef): bool {
    float ax = eng_x(kaynak); float ay = eng_y(kaynak) + 0.4; float az = eng_z(kaynak);
    float bx = eng_x(hedef);  float by = eng_y(hedef) + 0.4;  float bz = eng_z(hedef);
    float dx = bx - ax; float dy = by - ay; float dz = bz - az;
    float uz = sqrt(dx * dx + dy * dy + dz * dz);
    if (uz < 0.001) { return true; }
    float d = eng_raycast(ax, ay, az, dx, dy, dz, uz, kaynak);
    if (d < 0.0) { return true; }
    return eng_ray_id() == hedef;
}
func has_line_of_sight(src, dst): bool { return gorus_var(src, dst); }

// ---- Navmesh (sahnedeki bake; runtime yalnız sorgular) ----------------------
// Bake engine_sahnec'te yapılır: sahnedeki SABİT KUTU gövdelerden. Sahnede
// yürünebilir zemin yoksa bake olmaz -> nav_var() false, oyun düz yola düşer.
func nav_var(): bool { return eng_nav_ok(); }
func nav_ok(): bool { return eng_nav_ok(); }
func nav_poligon(): int { return eng_nav_polys(); }
func nav_yol(fx, fy, fz, tx, ty, tz): int { return eng_nav_path(fx, fy, fz, tx, ty, tz); }
func nav_path(fx, fy, fz, tx, ty, tz): int { return eng_nav_path(fx, fy, fz, tx, ty, tz); }
func nav_kismi(): bool { return eng_nav_partial(); }
func nav_x(i): float { return eng_nav_x(i); }
func nav_y(i): float { return eng_nav_y(i); }
func nav_z(i): float { return eng_nav_z(i); }
// Navmesh'e en yakın nokta. Ajan mesh'in birkaç santim dışındaysa nav_yol()
// 0 döner — önce buraya yapıştır, sonra yolu iste.
func nav_yakin(x, y, z): bool { return eng_nav_nearest(x, y, z); }
func nav_nearest(x, y, z): bool { return eng_nav_nearest(x, y, z); }
func nav_yakin_x(): float { return eng_nav_near_x(); }
func nav_yakin_y(): float { return eng_nav_near_y(); }
func nav_yakin_z(): float { return eng_nav_near_z(); }
func nav_near_x(): float { return eng_nav_near_x(); }
func nav_near_y(): float { return eng_nav_near_y(); }
func nav_near_z(): float { return eng_nav_near_z(); }
// Doğru görüş: true = ENGEL VAR (yol ara), false = dümdüz gidilebilir.
// Yol aramadan çok daha ucuz; kovalayan düşman her karede bunu sorup
// yalnız engel varken yol arayabilir.
func nav_gorus(fx, fy, fz, tx, ty, tz): bool { return eng_nav_raycast(fx, fy, fz, tx, ty, tz); }
func nav_raycast(fx, fy, fz, tx, ty, tz): bool { return eng_nav_raycast(fx, fy, fz, tx, ty, tz); }
func nav_gorus_t(): float { return eng_nav_ray_t(); }
func nav_ray_t(): float { return eng_nav_ray_t(); }

// ---- Oyun yardımcıları: yön ve görüş ------------------------------------------
// Her aksiyon oyununun yeniden yazdığı iki parça. Unity'de NavMeshAgent,
// Godot'da NavigationAgent3D bunları hazır verir; burada Tulpar'da, tek yerde.
// Eskiden engine_aksiyon.tpr'deydi (39 + 15 satır).

// `id`den `hedef`e YATAY birim yön. Navmesh varsa Detour düz yolunun ilk
// anlamlı (0.6 m'den uzak) köşesine, yoksa düz çizgiye. Önünde 1.5 m içinde
// SAHNE geometrisi (isin_id() == 0) varsa yüzey normali boyunca kayar:
// duvara sürtünür, takılmaz. Oyuncu ve diğer varlıklar engel SAYILMAZ —
// sayılsaydı kovalayan düşman oyuncuyu "duvar" sanıp ondan sekerdi
// (ölçüldü 2026-09-24: 3200 karede iki düşman 1.9 m'de asılı kalıyordu).
// Hedefteyse (0, 0, 0).
func yol_yonu(int id, Vec3 hedef): Vec3 {
    Vec3 p = konum(id);
    float hx = hedef.x - p.x;
    float hz = hedef.z - p.z;
    if (eng_nav_ok()) {
        int n = eng_nav_path(p.x, 0.3, p.z, hedef.x, 0.3, hedef.z);
        for (int k = 1; k < n; k++) {
            float wx = eng_nav_x(k) - p.x;
            float wz = eng_nav_z(k) - p.z;
            if (wx * wx + wz * wz > 0.36) {
                hx = wx;
                hz = wz;
                break;
            }
        }
    }
    float uz = sqrt(hx * hx + hz * hz);
    if (uz < 0.0001) { return v3(0.0, 0.0, 0.0); }
    hx = hx / uz;
    hz = hz / uz;
    // Engel ışını bel hizasından (0.55 m): alçak bir kenarın üstünden geçer.
    float d = eng_raycast(p.x, 0.55, p.z, hx, 0, hz, 1.5, id);
    if (d >= 0.0 && eng_ray_id() == 0) {
        float nx = eng_ray_nx();
        float nz = eng_ray_nz();
        float nok = hx * nx + hz * nz;
        hx = hx - nx * nok * 1.7;
        hz = hz - nz * nok * 1.7;
        float u2 = sqrt(hx * hx + hz * hz);
        if (u2 > 0.0001) {
            hx = hx / u2;
            hz = hz / u2;
        }
    }
    return v3(hx, 0.0, hz);
}
func path_direction(int id, Vec3 target): Vec3 { return yol_yonu(id, target); }

// `bakan`, `hedef`i görüyor mu: menzil + bakış konisi + görüş hattı (ışın).
// `cos_esik` bakış yönüyle nokta çarpımın alt sınırı (0.3 ~ ±72 derece);
// -1'in altı koniyi kapatır (ör. zaten kovalarken: yalnız menzil ve hat).
func goruyor_mu(int bakan, int hedef, float bakis_yaw, float menzil, float cos_esik): bool {
    Vec3 a = konum(bakan);
    Vec3 b = konum(hedef);
    float uz = uzaklik_xz(a, b);
    if (uz >= menzil) { return false; }
    float nok = (b.x - a.x) / uz * (0.0 - sin(bakis_yaw)) + (b.z - a.z) / uz * (0.0 - cos(bakis_yaw));
    if (nok <= cos_esik) { return false; }
    return gorus_var(bakan, hedef);
}
func can_see(int viewer, int target, float yaw, float range, float cos_min): bool { return goruyor_mu(viewer, target, yaw, range, cos_min); }

// ---- Navmesh ajanı: yol TAKİBİ ---------------------------------------------
// Motorda ajan YOK ve bilerek yok. Yol ARAMA motorda (Detour, C++); yol
// TAKİBİ burada, saf Tulpar'da. Sebep: takip oynanış politikasıdır — hız,
// varış yarıçapı, yeniden yol arama sıklığı her oyunda farklıdır. Motora
// gömmek her oyunu aynı davranışa mahkûm ederdi. Motor mekanizmayı verir,
// bu katman politikayı kurar. Değiştirmek isteyen bu dosyayı kopyalar.
//
// Yol noktaları ajan başına KOPYALANIR: motorun nokta tamponu tektir ve bir
// sonraki nav_yol() çağrısı üzerine yazar. İki ajan aynı karede yol ararsa
// kopyalamayan bir tasarım sessizce birbirinin yolunu takip ederdi.
int _AG_MAX_NOKTA = 32;   // motorun kMaxNavPoints'i ile aynı
array _ag_x = [];
array _ag_y = [];
array _ag_z = [];
array _ag_hiz = [];
array _ag_yaricap = [];
array _ag_n = [];        // yoldaki nokta sayısı (0 = yol yok)
array _ag_i = [];        // sıradaki nokta indisi
array _ag_px = [];       // düz saklama: ajan * _AG_MAX_NOKTA + k
array _ag_py = [];
array _ag_pz = [];

func _ag_gecerli(a): bool {
    if (a < 0) { return false; }
    if (a >= len(_ag_x)) { return false; }
    return true;
}

// Yeni ajan. hiz birim/sn, yaricap = "vardım" sayılan mesafe.
func ajan_olustur(x, y, z, hiz, yaricap): int {
    int a = len(_ag_x);
    push(_ag_x, x); push(_ag_y, y); push(_ag_z, z);
    push(_ag_hiz, hiz); push(_ag_yaricap, yaricap);
    push(_ag_n, 0); push(_ag_i, 0);
    int k = 0;
    while (k < _AG_MAX_NOKTA) {
        push(_ag_px, 0.0); push(_ag_py, 0.0); push(_ag_pz, 0.0);
        k = k + 1;
    }
    return a;
}
func agent_create(x, y, z, speed, radius): int { return ajan_olustur(x, y, z, speed, radius); }

// Hedef ata: navmesh'te yol ara ve ajana KOPYALA. false = yol yok.
// Başlangıç ve hedef önce mesh'e yapıştırılır (ikisi de birkaç santim dışarıda
// olabilir; yapıştırmadan istenen yol sessizce 0 nokta dönerdi).
func ajan_hedef(a, hx, hy, hz): bool {
    if (!_ag_gecerli(a)) { return false; }
    _ag_n[a] = 0;
    _ag_i[a] = 0;
    if (!nav_var()) { return false; }
    float bx = _ag_x[a]; float by = _ag_y[a]; float bz = _ag_z[a];
    if (eng_nav_nearest(bx, by, bz)) {
        bx = eng_nav_near_x(); by = eng_nav_near_y(); bz = eng_nav_near_z();
    }
    float gx = hx; float gy = hy; float gz = hz;
    if (eng_nav_nearest(gx, gy, gz)) {
        gx = eng_nav_near_x(); gy = eng_nav_near_y(); gz = eng_nav_near_z();
    }
    int n = eng_nav_path(bx, by, bz, gx, gy, gz);
    if (n <= 0) { return false; }
    if (n > _AG_MAX_NOKTA) { n = _AG_MAX_NOKTA; }
    int taban = a * _AG_MAX_NOKTA;
    int k = 0;
    while (k < n) {
        _ag_px[taban + k] = eng_nav_x(k);
        _ag_py[taban + k] = eng_nav_y(k);
        _ag_pz[taban + k] = eng_nav_z(k);
        k = k + 1;
    }
    _ag_n[a] = n;
    // 0. nokta ajanın kendi konumudur; ilk hedef 1. nokta.
    if (n > 1) { _ag_i[a] = 1; } else { _ag_i[a] = 0; }
    return true;
}
func agent_target(a, x, y, z): bool { return ajan_hedef(a, x, y, z); }

// Bir kare ilerlet. false = yol bitti ya da yol yok (oyun yeni hedef verebilir).
func ajan_ilerlet(a, dt): bool {
    if (!_ag_gecerli(a)) { return false; }
    if (_ag_n[a] <= 0) { return false; }
    if (_ag_i[a] >= _ag_n[a]) { return false; }
    int taban = a * _AG_MAX_NOKTA;
    float adim = _ag_hiz[a] * dt;
    // Bir karede birden fazla köşe geçilebilir (hızlı ajan, sık köşe):
    // döngü, adım bütçesi bitene ya da yol tükenene kadar sürer.
    while (adim > 0.0) {
        if (_ag_i[a] >= _ag_n[a]) { return false; }
        int h = taban + _ag_i[a];
        float dx = _ag_px[h] - _ag_x[a];
        float dy = _ag_py[h] - _ag_y[a];
        float dz = _ag_pz[h] - _ag_z[a];
        float uz = sqrt(dx * dx + dy * dy + dz * dz);
        if (uz <= _ag_yaricap[a]) {
            // Köşeye vardı: sonrakine geç. Konumu köşeye OTURTMA — yarıçap
            // içindeyken zıplatmak titreme yapar.
            _ag_i[a] = _ag_i[a] + 1;
            if (_ag_i[a] >= _ag_n[a]) { return false; }
            continue;
        }
        if (uz <= adim) {
            _ag_x[a] = _ag_px[h]; _ag_y[a] = _ag_py[h]; _ag_z[a] = _ag_pz[h];
            adim = adim - uz;
            _ag_i[a] = _ag_i[a] + 1;
            continue;
        }
        float t = adim / uz;
        _ag_x[a] = _ag_x[a] + dx * t;
        _ag_y[a] = _ag_y[a] + dy * t;
        _ag_z[a] = _ag_z[a] + dz * t;
        adim = 0.0;
    }
    return true;
}
func agent_step(a, dt): bool { return ajan_ilerlet(a, dt); }

func ajan_x(a): float { if (!_ag_gecerli(a)) { return 0.0; } return _ag_x[a]; }
func ajan_y(a): float { if (!_ag_gecerli(a)) { return 0.0; } return _ag_y[a]; }
func ajan_z(a): float { if (!_ag_gecerli(a)) { return 0.0; } return _ag_z[a]; }
func agent_x(a): float { return ajan_x(a); }
func agent_y(a): float { return ajan_y(a); }
func agent_z(a): float { return ajan_z(a); }
// Ajanı ışınla (doğuş, geri sarma). Yol DÜŞER: eski yol yeni konumdan geçmiyor.
func ajan_koy(a, x, y, z): bool {
    if (!_ag_gecerli(a)) { return false; }
    _ag_x[a] = x; _ag_y[a] = y; _ag_z[a] = z;
    _ag_n[a] = 0; _ag_i[a] = 0;
    return true;
}
func agent_place(a, x, y, z): bool { return ajan_koy(a, x, y, z); }
func ajan_hiz_ayarla(a, h): bool {
    if (!_ag_gecerli(a)) { return false; }
    _ag_hiz[a] = h;
    return true;
}
func agent_set_speed(a, s): bool { return ajan_hiz_ayarla(a, s); }
// Yolda kalan nokta sayısı (0 = yol yok ya da bitti).
func ajan_kalan(a): int {
    if (!_ag_gecerli(a)) { return 0; }
    if (_ag_i[a] >= _ag_n[a]) { return 0; }
    return _ag_n[a] - _ag_i[a];
}
func agent_remaining(a): int { return ajan_kalan(a); }
func ajan_vardi(a): bool { return ajan_kalan(a) == 0; }
func agent_arrived(a): bool { return ajan_kalan(a) == 0; }
func ajan_sayisi(): int { return len(_ag_x); }
func agent_count(): int { return len(_ag_x); }

// ---- Model animasyonu -------------------------------------------------------
func klip_sayisi(m): int { return eng_model_clip_count(m); }
func clip_count(m): int { return eng_model_clip_count(m); }
func klip_suresi(m, k): float { return eng_model_clip_duration(m, k); }
func klip_adi(m, k): str { return eng_model_clip_name(m, k); }
// Varlığa klip ata: hız 1.0 normal, döngü true = sürekli.
func animasyon(id, klip, hiz, dongu) { eng_set_anim(id, klip, hiz, dongu); }
func anim(id, clip, speed, loop) { eng_set_anim(id, clip, speed, loop); }
func animasyon_dur(id) { eng_set_anim(id, -1, 1.0, false); }
func anim_stop(id) { eng_set_anim(id, -1, 1.0, false); }
func animasyon_zamani(id): float { return eng_anim_time(id); }
func animasyon_bitti(id): bool { return eng_anim_done(id); }
func anim_done(id): bool { return eng_anim_done(id); }

// ---- Ses ---------------------------------------------------------------------
// Cihaz açılamazsa oyun SESSİZ devam eder (hata loglanır, çağrılar yok sayılır).
func ses_ac(): bool { return eng_audio_open(0, 0); }
func audio_open(): bool { return eng_audio_open(0, 0); }
func ses_kapat() { eng_audio_close(); }
func audio_close() { eng_audio_close(); }
func ses_var(): bool { return eng_audio_ok(); }
func audio_ok(): bool { return eng_audio_ok(); }
func ses_cihazi(): str { return eng_audio_backend(); }
func ses_yukle(yol): int { return eng_audio_load(yol); }
func audio_load(path): int { return eng_audio_load(path); }
func ton(hz, saniye): int { return eng_audio_tone(hz, saniye); }
func tone(hz, seconds): int { return eng_audio_tone(hz, seconds); }
func cal(klip, seviye, dongu): int { return eng_audio_play(klip, seviye, dongu); }
func play_sound(clip, gain, loop): int { return eng_audio_play(clip, gain, loop); }
func bip(hz, saniye, seviye): int { return eng_audio_beep(hz, saniye, seviye); }
func beep(hz, seconds, gain): int { return eng_audio_beep(hz, seconds, gain); }
func ses_durdur(id) { eng_audio_stop(id); }
func sesleri_durdur() { eng_audio_stop_all(); }
func stop_sounds() { eng_audio_stop_all(); }
func ses_seviyesi(s) { eng_audio_master(s); }
func master_volume(g) { eng_audio_master(g); }
func calan_ses(): int { return eng_audio_playing(); }
func playing_count(): int { return eng_audio_playing(); }
func ses_tepe(): float { return eng_audio_peak(); }

// Yatay yürüme: dikey hızı korur, x/z hızını verir (karakter kontrolü).
func yuru(id, vx, vz) { eng_set_velocity(id, vx, eng_vy(id), vz); }
// Yerde mi: dikey hız ~0 (basit; zıplama kilidi için yeterli).
func yerde(id): bool { float vy = eng_vy(id); return vy > -0.05 && vy < 0.05; }

// ---- Girdi -------------------------------------------------------------------
func tus(ad): bool { return eng_key_down(ad); }
func tus_basildi(ad): bool { return eng_key_pressed(ad); }
func key(name): bool { return eng_key_down(name); }
func dokunus_sayisi(): int { return eng_touch_count(); }
func cubuk_x(): float { return eng_stick_x(); }
func cubuk_y(): float { return eng_stick_y(); }
func eylem(): bool { return eng_stick_action(); }
// Klavye VEYA dokunmatik: WASD / ok tuşları / sanal joystick tek yön vektörü.
func yon_x(): float {
    float v = eng_stick_x();
    if (eng_key_down("D") || eng_key_down("RIGHT")) { v = v + 1.0; }
    if (eng_key_down("A") || eng_key_down("LEFT")) { v = v - 1.0; }
    if (v > 1.0) { v = 1.0; }
    if (v < -1.0) { v = -1.0; }
    return v;
}
func yon_y(): float {
    float v = eng_stick_y();
    if (eng_key_down("W") || eng_key_down("UP")) { v = v + 1.0; }
    if (eng_key_down("S") || eng_key_down("DOWN")) { v = v - 1.0; }
    if (v > 1.0) { v = 1.0; }
    if (v < -1.0) { v = -1.0; }
    return v;
}
// Zıpla/eylem: boşluk tuşu (kenar) VEYA sağ yarım ekrana dokunuş.
func eylem_basildi(): bool { return eng_key_pressed("SPACE") || eng_stick_action(); }

// ---- HUD ----------------------------------------------------------------------
func yazi(s, x, y, olcek, renk_) { eng_text(s, x, y, olcek, renk_); }
func text_e(s, x, y, scale, color) { eng_text(s, x, y, scale, color); }
func dikdortgen(x, y, w, h, renk_) { eng_rect(x, y, w, h, renk_); }
func rect_e(x, y, w, h, color) { eng_rect(x, y, w, h, color); }
// Sol üstte durum şeridi: FPS, çizim, gövde.
func durum_seridi() {
    str s = "fps " + toString(toInt(eng_fps())) + "  cizim " + toString(eng_draw_count()) + "  govde " + toString(eng_body_count()) + "  varlik " + toString(eng_count());
    float w = eng_text_width(s, 1.0);
    eng_rect(12, 12, w + 20, 34, SEFFAF_SIYAH);
    eng_text(s, 22, 18, 1.0, BEYAZ);
}

// ---- Anlık-kip (immediate mode) arayüz: menü, ayarlar, duraklat -------------
// Motorda YENİ çizim yolu yok: her widget `eng_rect` + `eng_text` kuyruklar.
// Değer BETİKTE yaşar (Tulpar'da çıktı parametresi yok): onay kutusu ve
// kaydırıcı YENİ değeri DÖNDÜRÜR, betik geri yazar:
//     ses = kaydirici("Ses", 40, 200, 380, 46, ses, 0.0, 1.0);
// Sıra her karede: ui_basla() -> widget'lar -> ui_bitir(). İşaretçi sırası:
// enjeksiyon (pencersiz test) > dokunmatik parmak 0 > fare sol tuşu.
// Koordinatsız yerleşim (ui_pencere, ui_dugme ...) aşağıda, "Arayüz yerleşimi".
func ui_basla() { eng_ui_begin(); _yr_sifirla(); }
func ui_bitir() { _yr_kare_sonu(); eng_ui_end(); }
func ui_begin() { ui_basla(); }
func ui_end() { ui_bitir(); }
func ui_tema(panel_renk, yazi_renk, vurgu) { eng_ui_theme(panel_renk, yazi_renk, vurgu); }
func ui_theme(panel_color, text_color, accent) { eng_ui_theme(panel_color, text_color, accent); }
// Devre dışı widget SOLUK çizilir ve değeri DEĞİŞMEZ (tıklama yutulur).
func ui_etkin(ac) { eng_ui_enable(ac); }
func ui_enable(on) { eng_ui_enable(on); }
func panel(x, y, w, h, renk_) { eng_ui_panel(x, y, w, h, renk_); }
func etiket(yazi_, x, y, olcek, renk_) { eng_ui_label(yazi_, x, y, olcek, renk_); }
func label(text, x, y, scale, color) { eng_ui_label(text, x, y, scale, color); }
// Her widget dikdörtgenini ADIYLA kaydeder (ui_test_tikla_ad, aşağıda).
func dugme(ad, x, y, w, h): bool { _ui_kaydet(ad, 1, x, y, w, h); return eng_ui_button(ad, x, y, w, h); }
func button(label_, x, y, w, h): bool { return dugme(label_, x, y, w, h); }
func onay_kutusu(ad, x, y, w, h, deger): bool { _ui_kaydet(ad, 2, x, y, w, h); return eng_ui_checkbox(ad, x, y, w, h, deger); }
func checkbox(label_, x, y, w, h, value): bool { return onay_kutusu(label_, x, y, w, h, value); }
func kaydirici(ad, x, y, w, h, deger, en_az, en_cok): float { _ui_kaydet(ad, 3, x, y, w, h); return eng_ui_slider(ad, x, y, w, h, deger, en_az, en_cok); }
func slider(label_, x, y, w, h, value, min_v, max_v): float { return kaydirici(label_, x, y, w, h, value, min_v, max_v); }
// Bir widget basılı/sürükleniyor mu — menü açıkken oyun girdisini bastırmak için.
func ui_basili(): bool { return eng_ui_active(); }
func ui_active(): bool { return eng_ui_active(); }
func ui_tiklama(): int { return eng_ui_clicks(); }
func ui_clicks(): int { return eng_ui_clicks(); }
// Pencersiz doğrulama: fare/dokunmatik yok, betik tek karelik bas+bırak enjekte
// eder (sonraki ui_basla() tüketir). Widget DIŞINA tıklama tetiklemez.
func ui_test_tikla(x, y) { eng_ui_test_click(x, y); }
func ui_test_click(x, y) { eng_ui_test_click(x, y); }
// Ekranda yatay ortalanmış bir kutunun sol kenarı (menü yerleşimi).
func ui_orta_x(w): float { return (genislik() - w) / 2.0; }
func ui_center_x(w): float { return (genislik() - w) / 2.0; }

// ---- Arayüz yerleşimi: koordinatsız widget'lar ------------------------------
// Yukarıdaki widget'lar her düğmenin yerini ister. "Gölge Salonları"nda menü
// kodu yerleri elle topluyordu (`dugme("Ayarlar", x, y + 70, w, 56)`) ve
// pencersiz doğrulama her düğmenin tıklama noktasını ayrı bir globalde
// saklıyordu (g_c_basla, g_c_ses ...). Burada DİKEY YIĞIN: bir imleç (x, y,
// genişlik, satır yüksekliği, aralık) widget'ları alt alta dizer:
//
//     ui_pencere("AYARLAR", 472, 400, 0);        // ortalanmış, başlıklı panel
//     ses = ui_kaydirici("Ses", ses, 0.0, 1.0);
//     parlama = ui_onay_kutusu("Parlama", parlama);
//     if (ui_dugme("Geri")) { ekran = Ekran.MENU; }
//     ui_pencere_bitir();                         // içerik sığmadıysa UYARI
//
// ÖLÇEK: yerleşimdeki her sayı 720p'lik TASARIM birimidir, ui_olcek()
// (= yukseklik() / 720) ile çarpılır. Köprünün fontu da ekran yüksekliğiyle
// yüklenir (1080p'de 28 px), yani düğme ve içindeki yazı birlikte büyür; 720p'de
// ölçek tam 1. Koordinatlı widget'lar (`dugme(ad, x, y, w, h)`) ham PİKSEL
// almaya devam eder; onlar için ui_px(v). Dikdörtgenler tam piksele yuvarlanır:
// kenar keskin kalır ve oranlı test tıklaması float'ta TAM düşer.
//
// ADLA TEST TIKLAMASI: her widget (koordinatlılar da) dikdörtgenini ADIYLA
// kaydeder; pencersiz doğrulama koordinat bilmeden tıklar:
//     ui_test_tikla_ad("Basla");             // sonraki karede tetiklenir
//     ui_test_tikla_oran("Ses", 0.25);       // kaydırıcı izinin %25'i -> 0.25
// Kayıt adın EN SON çizildiği yeri tutar: bu kare çizilmemiş ekranın düğmesi de
// istenebilir; tıklama sonraki karede tüketilir, düğme o karede oradaysa
// tetiklenir. Hiç çizilmemiş ad, yanlış tür ve [0, 1] dışı oran SESSİZ geçmez:
// false döner, UYARI loglanır, ui_uyari_sayisi() artar (köprünün
// uyari_sayisi()'ndan AYRI, Tulpar tarafı).
float UI_TASARIM_Y = 720.0;      // tasarım biriminin referans ekran yüksekliği
// Font 1080p'de 28 px (bridge/engine_api.cpp: vis_h / 1080 * 28) -> 720p'de
// 18.67: ui_etiket bir satırı (ölçek x) bu kadar ilerletir. Font en az 12 px:
// 463 px'ten alçak ekranda yazı satırdan biraz taşar.
float _UI_YAZI_BOY = 18.6667;
// Kaydırıcı izinin iki yandaki payı, PİKSEL (ölçeklenmez): teng_ui_slider'daki
// `pad` ile AYNI olmalı. run_yerlesim oranlı tıklamanın TAM değeri verdiğini
// ölçer; biri değişip öteki kalırsa kırmızı.
float _UI_KAYDIRICI_PAY = 12.0;
float _UI_PENCERE_PAY = 24.0;    // pencere iç kenar boşluğu (tasarım birimi)
float _UI_BASLIK_OLCEK = 1.5;
int _UI_KAYIT_MAX = 128;         // ayrı widget adı; dolunca UYARI, sessiz büyüme yok

float _ui_sabit_olcek = 0.0;     // 0 = otomatik (yukseklik() / 720)
int _ui_uyari = 0;
bool _ui_kayit_dolu = false;
bool _ui_tasma_bildirildi = false;
str _ui_tasma_son = "";
// Ad kaydı. tur: 1 düğme, 2 onay kutusu, 3 kaydırıcı (köprünün kimlik türleri).
array _ui_ad = [];
array _ui_tur = [];
array _ui_x = [];
array _ui_y = [];
array _ui_w = [];
array _ui_h = [];
// İmleç: konum ve genişlik PİKSEL; satır yüksekliği ve aralık TASARIM biriminde.
float _yr_x = 0.0;
float _yr_y = 0.0;
float _yr_w = 0.0;
float _yr_s = 1.0;
float _yr_satir = 56.0;
float _yr_ara = 14.0;
float _yr_alt = 0.0;             // son yerleşen öğenin alt kenarı (piksel)
bool _yr_pencere_acik = false;
str _yr_pencere = "";
float _yr_px = 0.0;
float _yr_py = 0.0;
float _yr_pw = 0.0;
float _yr_ph = 0.0;
float _yr_ph_tasarim = 0.0;

func ui_olcek(): float {
    if (_ui_sabit_olcek > 0.0) { return _ui_sabit_olcek; }
    return yukseklik() / UI_TASARIM_Y;
}
func ui_scale(): float { return ui_olcek(); }
// Ölçeği sabitle (1.0 = tasarım birimi piksel; test ve piksel-mükemmel HUD).
// 0 otomatiğe döner.
func ui_olcek_sabitle(float s) { _ui_sabit_olcek = s; }
func ui_px(float v): float { return v * ui_olcek(); }
func ui_uyari_sayisi(): int { return _ui_uyari; }
func ui_warning_count(): int { return _ui_uyari; }

func _ui_yuvarla(float v): float { return floor(v + 0.5); }
func _ui_uyar(str msg) {
    _ui_uyari += 1;
    eng_log("UYARI " + msg);
}
func _ui_bul(ad): int {
    for (int i = 0; i < len(_ui_ad); i++) {
        if (_ui_ad[i] == ad) { return i; }
    }
    return -1;
}
func _ui_kaydet(ad, int tur, float x, float y, float w, float h) {
    int i = _ui_bul(ad);
    if (i < 0) {
        if (len(_ui_ad) >= _UI_KAYIT_MAX) {
            if (!_ui_kayit_dolu) { _ui_kayit_dolu = true; _ui_uyar(t"arayuz ad kaydi dolu ({_UI_KAYIT_MAX}): '{ad}' ve sonraki yeni adlar adla tiklanamaz (etiketi her kare degisen widget mi?)"); }
            return;
        }
        push(_ui_ad, ad); push(_ui_tur, tur);
        push(_ui_x, x); push(_ui_y, y); push(_ui_w, w); push(_ui_h, h);
        return;
    }
    _ui_tur[i] = tur;
    _ui_x[i] = x; _ui_y[i] = y; _ui_w[i] = w; _ui_h[i] = h;
}

// ui_basla: imleç varsayılana. Genişlik 0: yerleşim kurulmadan çağrılan
// ui_dugme köprüde HATA sayar, geçen karenin yerine sessizce çizmez.
func _yr_sifirla() {
    _yr_s = ui_olcek();
    _yr_x = 0.0; _yr_y = 0.0; _yr_w = 0.0; _yr_alt = 0.0;
    _yr_satir = 56.0; _yr_ara = 14.0;
    _yr_pencere_acik = false;
}
func _yr_kare_sonu() {
    if (_yr_pencere_acik) { _ui_uyar(t"ui_bitir: '{_yr_pencere}' penceresi ui_pencere_bitir ile kapatilmadi"); }
    _yr_pencere_acik = false;
}
// Sıradaki satır: tam piksel y ve yükseklik; imleç satır + aralık kadar iner.
func _yr_yer(float boy): (float, float) {
    float y = _ui_yuvarla(_yr_y);
    float h = _ui_yuvarla(boy * _yr_s);
    _yr_y += (boy + _yr_ara) * _yr_s;
    _yr_alt = y + h;
    return y, h;
}

// Dikey yığın başlat: sol üst (x, y), genişlik, satır yüksekliği, aralık.
func ui_yerlesim(float x, float y, float w, float satir, float ara) {
    _yr_s = ui_olcek();
    _yr_x = _ui_yuvarla(x * _yr_s);
    _yr_y = y * _yr_s;
    _yr_w = _ui_yuvarla(w * _yr_s);
    _yr_satir = satir;
    _yr_ara = ara;
    _yr_alt = _yr_y;
}
func layout_begin(float x, float y, float w, float row_h, float gap) { ui_yerlesim(x, y, w, row_h, gap); }
func ui_satir(float h) { _yr_satir = h; }
func ui_ara(float a) { _yr_ara = a; }
func ui_bosluk(float h) { _yr_y += h * _yr_s; }
func layout_space(float h) { ui_bosluk(h); }

func ui_dugme(ad): bool {
    float y, h = _yr_yer(_yr_satir);
    return dugme(ad, _yr_x, y, _yr_w, h);
}
func layout_button(label_): bool { return ui_dugme(label_); }
func ui_onay_kutusu(ad, deger): bool {
    float y, h = _yr_yer(_yr_satir);
    return onay_kutusu(ad, _yr_x, y, _yr_w, h, deger);
}
func layout_checkbox(label_, value): bool { return ui_onay_kutusu(label_, value); }
func ui_kaydirici(ad, deger, en_az, en_cok): float {
    float y, h = _yr_yer(_yr_satir);
    return kaydirici(ad, _yr_x, y, _yr_w, h, deger, en_az, en_cok);
}
func layout_slider(label_, value, min_v, max_v): float { return ui_kaydirici(label_, value, min_v, max_v); }
// Yazı satırı (sola yaslı / ortalı). Satır yüksekliği fonttan: ölçek x 18.67.
func ui_etiket(yazi_, float olcek, int renk_) {
    float y, h = _yr_yer(_UI_YAZI_BOY * olcek);
    eng_ui_label(yazi_, _yr_x, y, olcek, renk_);
}
func layout_label(text, float scale, int color) { ui_etiket(text, scale, color); }
func ui_etiket_orta(yazi_, float olcek, int renk_) {
    float y, h = _yr_yer(_UI_YAZI_BOY * olcek);
    eng_ui_label(yazi_, _ui_yuvarla(_yr_x + (_yr_w - eng_text_width(yazi_, olcek)) / 2.0), y, olcek, renk_);
}

// Ekranda ORTALANMIŞ panel + başlık; imleç içine kurulur (satır 56, aralık 14;
// değiştirmek için ardından ui_satir / ui_ara). w, h panelin DIŞ ölçüsü
// (tasarım birimi); ekrandan genişse ekrana sığdırılır. renk_ 0 = tema.
// Başlık "" ise başlık satırı yok. Kapatan: ui_pencere_bitir().
func ui_pencere(baslik, float w, float h, int renk_) {
    if (_yr_pencere_acik) { _ui_uyar(t"ui_pencere '{baslik}': onceki '{_yr_pencere}' penceresi kapatilmadi"); }
    float s = ui_olcek();
    float pw = _ui_yuvarla(min(w * s, genislik() - 16.0 * s));
    float ph = _ui_yuvarla(h * s);
    float px = _ui_yuvarla((genislik() - pw) / 2.0);
    float py = _ui_yuvarla((yukseklik() - ph) / 2.0);
    eng_ui_panel(px, py, pw, ph, renk_);
    float pay = _ui_yuvarla(_UI_PENCERE_PAY * s);
    _yr_s = s;
    _yr_x = px + pay; _yr_y = py + pay; _yr_w = pw - 2.0 * pay; _yr_alt = _yr_y;
    _yr_satir = 56.0; _yr_ara = 14.0;
    _yr_pencere_acik = true;
    _yr_pencere = baslik;
    _yr_px = px; _yr_py = py; _yr_pw = pw; _yr_ph = ph; _yr_ph_tasarim = h;
    if (len(baslik) > 0) { ui_etiket(baslik, _UI_BASLIK_OLCEK, 0); }
}
func ui_window(title, float w, float h, int color) { ui_pencere(title, w, h, color); }
// İçerik panelin iç alanından taştıysa UYARI (gereken yükseklikle, bir kez),
// sonra imleci panelin ALTINA taşır: pencereye bağlı bir ipucu satırı için.
func ui_pencere_bitir() {
    if (!_yr_pencere_acik) { _ui_uyar("ui_pencere_bitir: acik pencere yok"); return; }
    _yr_pencere_acik = false;
    float pay = _ui_yuvarla(_UI_PENCERE_PAY * _yr_s);
    if (_yr_alt > _yr_py + _yr_ph - pay && (!_ui_tasma_bildirildi || _ui_tasma_son != _yr_pencere)) {
        _ui_tasma_bildirildi = true;
        _ui_tasma_son = _yr_pencere;
        int gereken = toInt((_yr_alt + pay - _yr_py) / _yr_s + 0.999);
        _ui_uyar(t"ui_pencere '{_yr_pencere}': icerik panele sigmadi, gereken yukseklik {gereken} (verilen {_yr_ph_tasarim})");
    }
    _yr_x = _yr_px;
    _yr_w = _yr_pw;
    _yr_y = _yr_py + _yr_ph + _yr_ara * _yr_s;
    _yr_alt = _yr_y;
}
func ui_window_end() { ui_pencere_bitir(); }

// Kayıttaki dikdörtgen (piksel, en son çizildiği yer); ad yoksa -1.
func ui_oge_var(ad): bool { return _ui_bul(ad) >= 0; }
func ui_oge_x(ad): float { int i = _ui_bul(ad); if (i < 0) { return -1.0; } return _ui_x[i]; }
func ui_oge_y(ad): float { int i = _ui_bul(ad); if (i < 0) { return -1.0; } return _ui_y[i]; }
func ui_oge_w(ad): float { int i = _ui_bul(ad); if (i < 0) { return -1.0; } return _ui_w[i]; }
func ui_oge_h(ad): float { int i = _ui_bul(ad); if (i < 0) { return -1.0; } return _ui_h[i]; }

// Pencersiz doğrulama: adıyla tıkla (dikdörtgenin ortası). false = tıklama YOK.
func ui_test_tikla_ad(ad): bool {
    int i = _ui_bul(ad);
    if (i < 0) { _ui_uyar(t"ui_test_tikla_ad: '{ad}' adinda widget hic cizilmedi, tiklama YOK"); return false; }
    eng_ui_test_click(_ui_x[i] + _ui_w[i] / 2.0, _ui_y[i] + _ui_h[i] / 2.0);
    return true;
}
func ui_test_click_name(name): bool { return ui_test_tikla_ad(name); }
// Kaydırıcıyı izinin `oran`ına (0..1) tıkla: değer en_az + oran * (en_cok - en_az).
func ui_test_tikla_oran(ad, float oran): bool {
    int i = _ui_bul(ad);
    if (i < 0) { _ui_uyar(t"ui_test_tikla_oran: '{ad}' adinda widget hic cizilmedi, tiklama YOK"); return false; }
    if (_ui_tur[i] != 3) { _ui_uyar(t"ui_test_tikla_oran: '{ad}' kaydirici degil (tur {_ui_tur[i]}), tiklama YOK"); return false; }
    if (oran < 0.0 || oran > 1.0) { _ui_uyar(t"ui_test_tikla_oran: '{ad}' orani {oran} [0, 1] disinda, tiklama YOK"); return false; }
    eng_ui_test_click(_ui_x[i] + _UI_KAYDIRICI_PAY + (_ui_w[i] - 2.0 * _UI_KAYDIRICI_PAY) * oran, _ui_y[i] + _ui_h[i] / 2.0);
    return true;
}
func ui_test_click_ratio(name, float ratio): bool { return ui_test_tikla_oran(name, ratio); }

// ---- Kalıcı kayıt: ayarlar ve en yüksek skor -------------------------------
// Motor KURULMADAN da çalışır: parlama gibi ayarlar `motor_ac`'tan ÖNCE okunur.
// Yol: TULPAR_ENGINE_SAVE, yoksa çalışma dizininde "tulpar_kayit.txt"
// (Android'de çalışma dizini APK çıkarma köküdür: yazılabilir dahili dizin).
// Bozuk satır sessizce yutulmaz: hata loglanır ve hata_sayisi() artar.
func kayit_ac(yol): bool { return eng_save_open(yol); }
func save_open(path): bool { return eng_save_open(path); }
func kayit_yolu(): str { return eng_save_path(); }
func save_path(): str { return eng_save_path(); }
// Ad notu: `kayit_yaz/kayit_oku` tame'de BASKA anlamda var (dosya kaydi); iki
// modul birlikte import edilirse ad sessizce cakisirdi — burada adlar ayrik.
func kayit_yaz_sayi(anahtar, deger) { eng_save_set(anahtar, deger); }
func save_set(key, value) { eng_save_set(key, value); }
func kayit_oku_sayi(anahtar, varsayilan): float { return eng_save_get(anahtar, varsayilan); }
func save_get(key, def): float { return eng_save_get(key, def); }
func kayit_yaz_metin(anahtar, deger) { eng_save_set_str(anahtar, deger); }
func kayit_oku_metin(anahtar, varsayilan): str { return eng_save_get_str(anahtar, varsayilan); }
func save_set_str(key, value) { eng_save_set_str(key, value); }
func save_get_str(key, def): str { return eng_save_get_str(key, def); }
func kayit_var(anahtar): bool { return eng_save_has(anahtar); }
func save_has(key): bool { return eng_save_has(key); }
func kayit_kaydet(): bool { return eng_save_write(); }
func save_write(): bool { return eng_save_write(); }
func kayit_temizle() { eng_save_clear(); }
func save_clear() { eng_save_clear(); }
func kayit_sayisi(): int { return eng_save_count(); }
func save_count(): int { return eng_save_count(); }
// En yüksek skor: yeni rekorsa yazar + diske kaydeder, rekoru döndürür.
func rekor_guncelle(anahtar, skor): int {
    int eski = toInt(eng_save_get(anahtar, 0));
    if (skor > eski) {
        eng_save_set(anahtar, skor);
        eng_save_write();
        return skor;
    }
    return eski;
}

// ---- Sahne sıcak yeniden yükleme (editörde "Derle" -> oyun yenilenir) ------
// İzleme açıkken yüklü `.sahneb` dosyasının damgası (zaman + boyut) izlenir;
// değişim görülünce bir kontrol daha beklenir (yarım yazılmış blob yüklenmesin),
// sonra sahne boşaltılıp yeniden yüklenir. Olay: `sahne_yenilendi()` BİR KEZ
// true döner. Sahne varlığı dizinleri değişir: adla yeniden bulun.
func sahne_izle(ac) { eng_scene_watch(ac); }
func scene_watch(on) { eng_scene_watch(on); }
func sahne_yenilendi(): bool { return eng_scene_reloaded(); }
func scene_reloaded(): bool { return eng_scene_reloaded(); }
func sahne_yenileme_sayisi(): int { return eng_scene_reload_count(); }
func scene_reload_count(): int { return eng_scene_reload_count(); }
func sahne_yolu(): str { return eng_scene_path(); }
func scene_path(): str { return eng_scene_path(); }
// İkili dosya kopyalama: .sahneb gibi NUL içeren bloblar Tulpar string'ine
// sığmaz (read_file/write_file metin içindir).
func dosya_kopyala(kaynak, hedef): bool { return eng_file_copy(kaynak, hedef); }
func file_copy(src, dst): bool { return eng_file_copy(src, dst); }
func dosya_zamani(yol): float { return eng_file_mtime(yol); }
func file_mtime(path): float { return eng_file_mtime(path); }
