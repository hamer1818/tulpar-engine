// Tulpar Engine — "Gölge Salonları": üçüncü şahıs aksiyon dikey dilimi.
// Motor C++; OYUN MANTIĞININ TAMAMI bu dosyada, Tulpar'da.
//
//   ./tulpar examples/engine_aksiyon.tpr                     # oyna (pencere)
//   engine_sahnec examples/assets/salon1.sahne               # bölüm 1 blob'u (editörün F5'i kendisi derler)
//   engine_sahnec examples/assets/salon2.sahne               # bölüm 2 blob'u
//
// Pencersiz doğrulama (OTOPİLOT açılır: betik kendi oynar, sayılar ölçülür):
//   TULPAR_ENGINE_HEADLESS=3200 DISPLAY= ./tulpar examples/engine_aksiyon.tpr
// Ayrıntılı log: TULPAR_ENGINE_LOG=2 (durum değişimi), 3 (her API çağrısı).
// Android:  ./tulpar build --target=android examples/engine_aksiyon.tpr out/aksiyon --apk
//
// OYNANIŞ
//   WASD / ok tuşları / sol yarım ekran   yürü (kameraya göre)   SPACE  zıpla
//   sağ fare tuşuyla sürükle / Q-E / sağ yarım ekran sürükleme   kamerayı döndür
//   J / sol tık / sağ yarım ekrana dokunuş   vuruş (düşmanı savurur)
//   SHIFT  atılma   R oyun sonunda yeniden başlatır, ESC duraklatır (menüde çıkar).
//
// Oyun kabuğu: ana menü, duraklat (ESC ya da sağ üstteki "||"), ayarlar (ses,
// parlama) ve rekor kalıcı kayıtta. Sahne sıcak yüklenir: editörde "Derle" ->
// oyun salonu kendiliğinden yeniler. Hedef: salondaki düşmanları temizle, açılan
// KAPI şeridine bas; bölüm 1 -> 2.
//
// Düşman: DEVRİYE (iki nokta arası) ve KOVALAMA; geçiş görüş menzili + bakış
// konisi + görüş hattı. Yol ve görüş motorun Tulpar kitaplığında (engine.tpr
// yol_yonu, goruyor_mu): navmesh varsa Detour yolu, yoksa düz çizgi + duvardan
// kayma. `.sahneb` yoksa (türetilmiş, gitignore'lu) salon KODDA kurulur.
//
// 2026-09-24: dilin olanaklarıyla yeniden yazıldı (for/break, +=, else if,
// kutusuz Vec3, kitaplıktaki yön/görüş). Oyun aynı: 3200 karelik kapı özeti ve
// fren ölçümü eski sürümle BAYT BAYT aynı (bkz. PR). 927 kod satırından bu hale.
// Aynı gün: menü/duraklat/ayarlar kitaplığın yerleşimiyle (engine.tpr "Arayüz
// yerleşimi") — hiçbir widget koordinat almıyor, otopilot düğmeleri ADIYLA tıklıyor.

import "engine";

// ---- Ayarlar ----------------------------------------------------------------
float OYUNCU_R = 0.45;
float OYUNCU_HIZ = 6.0;
float ZIPLAMA = 6.4;
float FREN = 12.0;           // yerde ve girdi yokken yatay hız sönümü (1/s): 6 m/s'den ~0.4 m'de durur
float ATILMA_HIZ = 15.0;     // atılma: bu hızla ATILMA_SURE boyunca (girdi ve fren askıda)
float ATILMA_SURE = 0.18;
float ATILMA_BEKLE = 1.1;
float ITILME_SURE = 0.22;    // darbe: savrulma hissedilsin diye girdi/fren askıda
float VURUS_ON = 1.0;        // vuruş küresi oyuncunun bu kadar önünde
float VURUS_R = 1.25;
float VURUS_BEKLE = 0.40;
float VURUS_ITME = 9.0;
// 50: iki vuruşta öldürür. 34'te otopilot 2. bölümde ölüyordu (3200 kare,
// 2026-09-24: 34 -> can 0; 50 -> 9 öldü, can 26, KAZANDI).
int VURUS_HASAR = 50;
int OYUNCU_CAN_MAX = 100;
int DUSMAN_CAN_MAX = 100;
float DUSMAN_R = 0.5;
float DUSMAN_HIZ_DEVRIYE = 2.2;
float DUSMAN_HIZ_KOVALA = 4.2;
float GORUS_MENZIL = 13.0;
float GORUS_COS = 0.30;      // bakış konisi (~±72 derece)
float KAYIP_SURE = 2.5;      // bu kadar göremezse devriyeye döner
float TEMAS_MENZIL = 1.25;
int TEMAS_HASAR = 11;
float HASAR_BEKLE = 0.85;
float AFIS_SURE = 2.2;

int RENK_OYUNCU = renk(232, 74, 64);
int RENK_DEVRIYE = renk(120, 96, 200);
int RENK_KOVALA = renk(232, 132, 40);
int RENK_FLAS = renk(255, 250, 220);
int RENK_CAN = renk(64, 200, 128);
int RENK_CAN_ZEMIN = renk_a(0, 0, 0, 150);
int RENK_KAPI = renk(80, 220, 140);

// ---- Durum ------------------------------------------------------------------
enum Durum { OYNA, AFIS, SON, KAZANDIN }
enum Ekran { MENU, OYUN, DURAKLAT, AYAR }
enum Hal { DEVRIYE, KOVALA }
enum Nokta { A, B }

int g_oyuncu = 0;
int g_can = 100;
int g_skor = 0;
int g_oldurulen = 0;
int g_bolum = 1;
int g_gecis_sayisi = 0;
Durum g_durum = Durum.OYNA;
Ekran g_ekran = Ekran.MENU;
Ekran g_ayar_donus = Ekran.MENU;
bool g_oynandi = false;       // bir kez oynandıysa "Başla" baştan kurar
float g_afis_t = 0.0;
float g_hasar_t = 0.0;
float g_vurus_t = 0.0;
float g_atilma_t = 0.0;       // atılma bekleme süresi
float g_atilma_kalan = 0.0;   // atılmanın kendisi
Vec3 g_atilma_yon = { x: 0.0, y: 0.0, z: 0.0 };
float g_serbest_t = 0.0;      // darbe: hız fiziğin
bool g_fare_once = false;     // sol tık KENARI için
float g_kam_yaw = 0.0;
float g_oyuncu_yaw = 0.0;
bool g_sahneden = false;
Vec3 g_kapi = { x: 0.0, y: 0.0, z: 0.0 };
float g_kapi_r = 2.0;
bool g_kapi_acik = false;
array g_kod = [];             // kodda kurulan yedek salonun varlıkları
// Ayarlar + rekor (kalıcı kayıt); parlama motor_ac'tan ÖNCE okunur.
float g_ses_ayari = 0.7;
bool g_parlama_ayari = true;
int g_rekor = 0;
bool g_ses_var = false;
int g_yenileme = 0;
float g_yenileme_t = 0.0;

struct Dusman {
    int id;
    int can;
    Hal hal;
    float ax;                 // devriye A noktası
    float az;
    float bx;                 // devriye B noktası
    float bz;
    Nokta hedef;
    float yaw;                // bakış yönü (radyan)
    float kayip;              // kaç saniyedir göremiyor
    float flas;               // vuruş flaşı süresi
}
Dusman[] dusmanlar = [];

// ---- Düşmanlar --------------------------------------------------------------
func dusman_ekle(x, z, ax, az, bx, bz) {
    int id = kutu(x, DUSMAN_R, z, DUSMAN_R, DUSMAN_R, DUSMAN_R, true, RENK_DEVRIYE);
    if (id == 0) { logla(t"UYARI dusman kurulamadi ({x},{z})"); return; }
    push(dusmanlar, { id: id, can: DUSMAN_CAN_MAX, hal: Hal.DEVRIYE, ax: ax, az: az, bx: bx, bz: bz,
                      hedef: Nokta.A, yaw: 0.0, kayip: 0.0, flas: 0.0 });
}

func dusmanlari_bosalt() {
    for (dm in dusmanlar) { if (canli(dm.id)) { sil(dm.id); } }
    dusmanlar = [];
}

func canli_dusman(): int {
    int n = 0;
    for (dm in dusmanlar) { if (dm.can > 0) { n += 1; } }
    return n;
}

// Canlı düşmanın dizideki yeri; yoksa -1.
func dusman_indeksi(id): int {
    for (int i = 0; i < len(dusmanlar); i++) {
        if (dusmanlar[i].id == id && dusmanlar[i].can > 0) { return i; }
    }
    return -1;
}

func dusman_oldu(i, str neden) {
    dusmanlar[i].can = 0;
    g_skor += 100;
    g_oldurulen += 1;
    sil(dusmanlar[i].id);
    logla(t"dusman {i} {neden} (kalan {canli_dusman()})");
}

// ---- Bölüm kurulumu ---------------------------------------------------------
// Adayları sırayla dener (masaüstünde depo kökü, cihazda çıkarma kökü). Önce
// file_exists: türetilmiş blob'un yokluğu hata sayacını doldurmasın.
func sahne_dene(ad): bool {
    for (yol in ["examples/assets/" + ad, "assets/" + ad, ad]) {
        if (!file_exists(yol)) { logla("sahne adayi yok: " + yol); }
        else if (sahne_yukle(yol)) { logla("sahne yuklendi: " + yol); return true; }
        else { logla("sahne acilamadi (bozuk/eski blob): " + yol); }
    }
    return false;
}

// Yedek düzen: sahne blob'u yoksa aynı salonu KODDA kur (navmesh olmaz).
func salonu_kodda_kur(n) {
    float y = n == 2 ? 16.0 : 13.0;
    int duvar = renk(76, 84, 100);
    int sutun = renk(128, 100, 82);
    push(g_kod, zemin_kur(y, renk(104, 112, 126)));
    push(g_kod, kutu(0, 1.25, 0 - y, y, 1.25, 0.5, false, duvar));
    push(g_kod, kutu(0, 1.25, y, y, 1.25, 0.5, false, duvar));
    push(g_kod, kutu(0 - y, 1.25, 0, 0.5, 1.25, y, false, duvar));
    push(g_kod, kutu(y, 1.25, 0, 0.5, 1.25, y, false, duvar));
    if (n == 1) {
        for (int k = 0; k < 4; k++) {
            push(g_kod, kutu(k % 2 == 0 ? -6 : 6, 1.5, k < 2 ? -6 : 6, 1.2, 1.5, 1.2, false, sutun));
        }
        push(g_kod, kutu(0, 0.6, 0, 3.0, 0.6, 0.6, false, sutun));
        push(g_kod, isik(0, 4, -8, renk(255, 198, 114), 4.0, 14.0));
    } else {
        push(g_kod, kutu(-3, 1.25, -2, 10.0, 1.25, 0.6, false, duvar));
        push(g_kod, kutu(6.4, 1.25, 4, 0.6, 1.25, 6.5, false, duvar));
        push(g_kod, kutu(-11, 1.5, 8, 1.1, 1.5, 1.1, false, sutun));
        push(g_kod, kutu(11, 1.5, -9, 1.1, 1.5, 1.1, false, sutun));
        push(g_kod, kutu(-9, 1.5, -10, 1.1, 1.5, 1.1, false, sutun));
        push(g_kod, isik(-9, 4.5, 2, renk(255, 128, 90), 4.5, 16.0));
    }
}

// Bölümü kurar: sahne (ya da kod yedeği) + oyuncu + düşmanlar + kapı.
func bolum_kur(n) {
    dusmanlari_bosalt();
    for (id in g_kod) { if (canli(id)) { sil(id); } }
    g_kod = [];
    if (g_oyuncu != 0 && canli(g_oyuncu)) { sil(g_oyuncu); }
    if (sahne_yuklu()) { sahne_bosalt(); }
    int hata_once = hata_sayisi();
    // Ad LİTERAL kalmalı: editörün F5'i sahneyi yükleyen oyunu bu dizgiyle bulur.
    g_sahneden = sahne_dene(n == 1 ? "salon1.sahneb" : "salon2.sahneb");
    g_kurulum_hatasi += hata_sayisi() - hata_once;
    if (g_sahneden) {
        logla(t"bolum {n}: sahneden {sahne_sayisi()} varlik, navmesh {nav_var()} ({nav_poligon()} poligon)");
        sahne_izle(true); // sıcak yükleme: editörde "Derle" -> oyun kendini yeniler
    } else {
        logla(t"UYARI salon{n}.sahneb yok -> salon KODDA kuruldu (navmesh yok). Derlemek icin: engine_sahnec examples/assets/salon{n}.sahne");
        salonu_kodda_kur(n);
    }
    g_oyuncu_yaw = 0.0;
    g_kam_yaw = 0.0;
    g_kapi_acik = false;
    if (n == 1) {
        g_oyuncu = kure(0.0, 1.0, 9.0, OYUNCU_R, true, RENK_OYUNCU);
        g_kapi = v3(0.0, 0.0, -11.5);
        g_kapi_r = 2.2;
        dusman_ekle(-8.0, -8.0, -10.0, -8.0, -3.0, -9.5);
        dusman_ekle(8.0, -8.0, 10.0, -8.0, 3.0, -9.5);
        dusman_ekle(-9.5, 4.0, -10.0, 1.5, -10.0, 9.5);
        dusman_ekle(9.5, 4.0, 10.0, 1.5, 10.0, 9.5);
    } else {
        g_oyuncu = kure(-12.0, 1.0, 12.0, OYUNCU_R, true, RENK_OYUNCU);
        g_kapi = v3(12.0, 0.0, 12.0);
        g_kapi_r = 2.4;
        dusman_ekle(-12.0, -8.0, -13.0, -10.0, -6.0, -6.0);
        dusman_ekle(10.0, -10.0, 12.0, -12.5, 9.0, -5.0);
        dusman_ekle(-8.0, 8.0, -12.0, 6.0, -4.0, 11.0);
        dusman_ekle(2.0, 8.0, 0.0, 5.0, 4.0, 12.0);
        dusman_ekle(12.0, 2.0, 13.0, -1.0, 11.0, 6.0);
    }
    logla(t"bolum {n} hazir: {len(dusmanlar)} dusman, kapi ({g_kapi.x},{g_kapi.z})");
}

func yeniden_basla() {
    g_bolum = 1;
    g_can = OYUNCU_CAN_MAX;
    g_skor = 0;
    g_oldurulen = 0;
    g_hasar_t = 0.0;
    g_vurus_t = 0.0;
    g_atilma_t = 0.0;
    g_atilma_kalan = 0.0;
    g_serbest_t = 0.0;
    g_durum = Durum.AFIS;
    g_afis_t = AFIS_SURE;
    bolum_kur(1);
    logla("yeniden baslandi");
}

func bolum_bitti_mi(): bool {
    if (canli_dusman() > 0) { return false; }
    if (!g_kapi_acik) {
        g_kapi_acik = true;
        logla(t"butun dusmanlar temizlendi — KAPI ACILDI (bolum {g_bolum})");
    }
    return uzaklik_xz(konum(g_oyuncu), g_kapi) < g_kapi_r;
}

// ---- Ayarlar: kalıcı kayıt --------------------------------------------------
// Pencersiz (otopilot) koşumda GEÇİCİ dosyaya: doğrulama gerçek kayda dokunmasın.
func ayar_dosyasi(): str {
    str tmp = env("TMPDIR");
    return (len(tmp) == 0 ? "/tmp" : tmp) + "/tulpar_aksiyon_kayit.txt";
}

func ayarlari_oku() {
    if (len(env("TULPAR_ENGINE_HEADLESS")) > 0) { kayit_ac(ayar_dosyasi()); }
    g_ses_ayari = kayit_oku_sayi("aksiyon_ses", 0.7);
    g_parlama_ayari = kayit_oku_sayi("aksiyon_parlama", 1.0) > 0.5;
    g_rekor = toInt(kayit_oku_sayi("aksiyon_rekor", 0));
}

func ayarlari_yaz() {
    kayit_yaz_sayi("aksiyon_ses", g_ses_ayari);
    kayit_yaz_sayi("aksiyon_parlama", g_parlama_ayari ? 1.0 : 0.0);
    kayit_kaydet();
    g_kayit_ses = kayit_oku_sayi("aksiyon_ses", -1.0);
    logla(t"ayarlar kaydedildi: ses {g_ses_ayari}, parlama {g_parlama_ayari} -> {kayit_yolu()}");
}

// Kapalı ses cihazına çağrı HATA loglar (köprü sessiz yutmaz): yalnız açıkken.
func ses_uygula() { if (g_ses_var) { ses_seviyesi(g_ses_ayari); } }

// ---- Oyun kabuğu: ana menü, duraklat, ayarlar -------------------------------
func oyuna_basla() {
    if (g_oynandi) { yeniden_basla(); }
    else { g_oynandi = true; g_durum = Durum.AFIS; g_afis_t = AFIS_SURE; }
    g_ekran = Ekran.OYUN;
    logla("oyun basladi (menuden)");
}

// Yerleşim kitaplıkta (engine.tpr "Arayüz yerleşimi"): pencere ortalanır,
// widget'lar alt alta dizilir, ölçüler ekran yüksekliğiyle ölçeklenir.
int RENK_PENCERE = renk_a(10, 12, 18, 228);
int RENK_KARART = renk_a(0, 0, 0, 120);

func menu_ciz() {
    ui_pencere("GOLGE SALONLARI", 432, 320, RENK_PENCERE);
    ui_etiket(t"rekor {g_rekor}   |   Tulpar Engine", 0.85, ACIK_GRI);
    if (ui_dugme("Basla")) { oyuna_basla(); }
    if (ui_dugme("Ayarlar")) { g_ayar_donus = Ekran.MENU; g_ekran = Ekran.AYAR; }
    if (ui_dugme("Cikis")) { ayarlari_yaz(); cikis_iste(); }
    ui_pencere_bitir();
    ui_etiket_orta("WASD/oklar yuru  SPACE zipla  SHIFT atil  J/sol tik vur  sag tik+surukle kamera  ESC duraklat", 0.72, GRI);
}

func duraklat_ciz() {
    dikdortgen(0, 0, genislik(), yukseklik(), RENK_KARART);
    ui_pencere("DURAKLADI", 388, 286, RENK_PENCERE);
    if (ui_dugme("Devam")) { g_ekran = Ekran.OYUN; }
    if (ui_dugme("Ayarlara git")) { g_ayar_donus = Ekran.DURAKLAT; g_ekran = Ekran.AYAR; }
    if (ui_dugme("Ana menu")) {
        g_rekor = rekor_guncelle("aksiyon_rekor", g_skor);
        g_oynandi = true;
        g_ekran = Ekran.MENU;
    }
    ui_pencere_bitir();
}

// Parlama motor kurulumunda açılır: onay kutusu YENİDEN BAŞLATINCA etkir.
func ayar_ciz() {
    dikdortgen(0, 0, genislik(), yukseklik(), RENK_KARART);
    ui_pencere("AYARLAR", 472, 400, RENK_PENCERE);
    float onceki = g_ses_ayari;
    g_ses_ayari = ui_kaydirici("Ses seviyesi", g_ses_ayari, 0.0, 1.0);
    if (g_ses_ayari != onceki) { ses_uygula(); }
    g_parlama_ayari = ui_onay_kutusu("Parlama (yeniden baslatinca)", g_parlama_ayari);
    ui_etiket("motor: " + eng_gpu_name(), 0.72, ACIK_GRI);
    ui_etiket(t"cozunurluk {genislik()}x{yukseklik()}   parlama simdi {parlama_acik()}", 0.72, ACIK_GRI);
    str nav_metni = nav_var() ? t"{nav_poligon()} poligon" : "yok";
    ui_etiket(t"navmesh {nav_metni}   ses cihazi {g_ses_var}", 0.72, ACIK_GRI);
    ui_etiket(t"sahne izleme acik: editorde Derle, oyun kendini yeniler ({g_yenileme})", 0.72, ACIK_GRI);
    if (ui_dugme("Geri")) { ayarlari_yaz(); g_ekran = g_ayar_donus; }
    ui_pencere_bitir();
}

// ---- Oyuncu -----------------------------------------------------------------
// Sol tık KENARI: basılı tutmak her VURUS_BEKLE'de bir savurmasın.
func vurus_istendi(): bool {
    bool fare = eng_mouse_down(0);
    bool kenar = fare && !g_fare_once;
    g_fare_once = fare;
    return tus_basildi("J") || eylem() || kenar;
}

// Fizik tabanlı vuruş: oyuncunun ÖNÜNDEKİ küre sorgusu; bulunan her düşmana
// dürtü (savurur) + hasar.
func vurus_yap() {
    if (g_vurus_t > 0.0) { return; }
    g_vurus_t = VURUS_BEKLE;
    Vec3 p = konum(g_oyuncu);
    Vec3 on = yaw_yonu(g_oyuncu_yaw);
    int n = yakinlar(p.x + on.x * VURUS_ON, p.y, p.z + on.z * VURUS_ON, VURUS_R, g_oyuncu);
    int vuran = 0;
    for (int k = 0; k < n; k++) {
        int id = yakin_id(k);
        int i = dusman_indeksi(id);
        if (i < 0) { continue; }
        Vec3 y = yon_xz(p, konum(id), on);
        itme(id, y.x * VURUS_ITME, 3.2, y.z * VURUS_ITME);
        dusmanlar[i].can -= VURUS_HASAR;
        dusmanlar[i].flas = 0.14;
        dusmanlar[i].hal = Hal.KOVALA;
        dusmanlar[i].kayip = 0.0;
        renk_ver(id, RENK_FLAS);
        vuran += 1;
        if (dusmanlar[i].can <= 0) { dusman_oldu(i, "dustu"); }
    }
    if (vuran == 0) { g_vurus_t = VURUS_BEKLE * 0.6; }
}

func oyuncuya_hasar(Vec3 kaynak, int hasar) {
    if (g_hasar_t > 0.0) { return; }
    g_hasar_t = HASAR_BEKLE;
    g_can -= hasar;
    Vec3 y = yon_xz(kaynak, konum(g_oyuncu), yaw_yonu(g_oyuncu_yaw));
    itme(g_oyuncu, y.x * 5.0, 2.6, y.z * 5.0);
    g_serbest_t = ITILME_SURE;
    g_atilma_kalan = 0.0;         // darbe atılmayı keser
    g_op_birak_gecerli = false;   // otopilotun fren ölçümü darbeyle bozuldu
    if (g_can <= 0) {
        g_can = 0;
        g_durum = Durum.SON;
        logla(t"OYUNCU OLDU — bolum {g_bolum}, skor {g_skor}");
    }
}

// Hareketin TEK yolu (oyuncu da otopilot da). Sıra: atılma > darbe > girdi > fren.
func oyuncu_hareket(Vec3 yon, bool girdi, bool yerde_mi, float d) {
    if (g_atilma_kalan > 0.0) {
        yuru_v(g_oyuncu, v_olcek(g_atilma_yon, ATILMA_HIZ));
        g_oyuncu_yaw = yon_yaw(g_atilma_yon);
    } else if (g_serbest_t > 0.0) {
        // savruluyor: hız fiziğin
    } else if (girdi) {
        g_oyuncu_yaw = yon_yaw(yon);
        yuru_v(g_oyuncu, v_olcek(yon, OYUNCU_HIZ));
    } else if (yerde_mi) {
        // Fren: yatay hız söner, dikey (düşüş, zıplama) dokunulmaz. Eskiden yoktu:
        // bırakıldıktan 3 s sonra top 15.7 m kaymış, hâlâ 4.8 m/s ile gidiyordu.
        float k = max(0.0, 1.0 - FREN * d);
        yuru(g_oyuncu, hiz_x(g_oyuncu) * k, hiz_z(g_oyuncu) * k);
    }
}

func oyuncu_guncelle(float d) {
    bool yerde_mi = yerde_isin(g_oyuncu, OYUNCU_R + 0.06, 0.22);
    if (g_otopilot) { otopilot(yerde_mi, d); return; }
    Vec3 h = kameraya_gore(g_kam_yaw, yon_x(), yon_y());
    bool girdi = uzunluk_xz(h) > 0.001;
    h = normal_xz(h);
    if (tus_basildi("SHIFT") && girdi && g_atilma_t <= 0.0 && g_serbest_t <= 0.0) {
        g_atilma_t = ATILMA_BEKLE;
        g_atilma_kalan = ATILMA_SURE;
        g_atilma_yon = h;
        logla("atilma");
    }
    oyuncu_hareket(h, girdi, yerde_mi, d);
    if (tus_basildi("SPACE") && yerde_mi) { itme(g_oyuncu, 0, ZIPLAMA, 0); }
    if (vurus_istendi()) { vurus_yap(); }
    if (konum_y(g_oyuncu) < -4.0) { dustu(); }
}

// Arenadan düşerse geri getir; biraz can al ki ceza görünsün.
func dustu() {
    isinla(g_oyuncu, 0, 2.0, 8.0);
    oyuncuya_hasar(v3(0.0, 0.0, 8.0), 10);
    logla("oyuncu dustu, geri getirildi");
}

// ---- Düşman yapay zekâsı ----------------------------------------------------
func dusman_guncelle(i, float d) {
    Dusman dm = dusmanlar[i];
    if (dm.can <= 0) { return; }
    if (!canli(dm.id)) { dusmanlar[i].can = 0; return; }
    Vec3 e = konum(dm.id);
    Vec3 p = konum(g_oyuncu);
    float uz = uzaklik_xz(e, p);
    // Görüş: menzil + koni + ışın hattı. Kovalarken koni aranmaz (peşinde).
    if (goruyor_mu(dm.id, g_oyuncu, dm.yaw, GORUS_MENZIL, dm.hal == Hal.KOVALA ? -2.0 : GORUS_COS)) {
        if (dm.hal == Hal.DEVRIYE) { logla(t"dusman {i} KOVALAMAYA gecti (uz {uz})"); }
        dm.hal = Hal.KOVALA;
        dm.kayip = 0.0;
    } else if (dm.hal == Hal.KOVALA) {
        dm.kayip += d;
        if (dm.kayip > KAYIP_SURE) {
            dm.hal = Hal.DEVRIYE;
            logla(t"dusman {i} oyuncuyu kaybetti, DEVRIYEYE dondu");
        }
    }
    Vec3 hedef = p;
    float hiz = DUSMAN_HIZ_KOVALA;
    if (dm.hal == Hal.DEVRIYE) {
        hedef = v3(dm.ax, 0.0, dm.az);
        if (dm.hedef == Nokta.B) { hedef = v3(dm.bx, 0.0, dm.bz); }
        hiz = DUSMAN_HIZ_DEVRIYE;
        if (uzaklik_xz(e, hedef) < 1.0) { dm.hedef = dm.hedef == Nokta.A ? Nokta.B : Nokta.A; }
    }
    Vec3 y = yol_yonu(dm.id, hedef);
    if (y.x != 0.0 || y.z != 0.0) {
        dm.yaw = yon_yaw(y);
        // Kovalarken temas menzilinin içinde durur (itişip kaymasın).
        if (dm.hal != Hal.KOVALA || uz > TEMAS_MENZIL * 0.8) { yuru_v(dm.id, v_olcek(y, hiz)); }
    }
    don_ver(dm.id, dm.yaw * 57.29578);
    if (uz < TEMAS_MENZIL && g_durum == Durum.OYNA) { oyuncuya_hasar(e, TEMAS_HASAR); }
    // Vuruş flaşı bitince renk duruma göre.
    if (dm.flas > 0.0) { dm.flas = max(0.0, dm.flas - d); }
    if (dm.flas <= 0.0) { renk_ver(dm.id, dm.hal == Hal.KOVALA ? RENK_KOVALA : RENK_DEVRIYE); }
    dusmanlar[i] = dm;
    if (e.y < -4.0) { dusman_oldu(i, "arenadan dustu"); } // savrulup düşen ölmüş sayılır
}

// ---- Kamera ve HUD ----------------------------------------------------------
// Bakış: sağ fare tuşuyla sürükleme / sağ yarım ekran sürükleme (eng_look_dx) ve Q/E.
func kamera_guncelle(float d) {
    float donus = (tus("E") ? 1.0 : 0.0) - (tus("Q") ? 1.0 : 0.0);
    g_kam_yaw = g_kam_yaw + donus * 2.3 * d + eng_look_dx() * 0.006;
    Vec3 p = konum(g_oyuncu);
    kamera_yorunge(p.x, p.y + 1.0, p.z, g_kam_yaw, 0.40, 9.5);
}

func hud_ciz() {
    durum_seridi();
    float oran = max(0.0, g_can * 1.0 / OYUNCU_CAN_MAX);
    dikdortgen(20, 56, 268, 26, RENK_CAN_ZEMIN);
    dikdortgen(24, 60, 260 * oran, 18, oran < 0.35 ? renk(232, 90, 70) : RENK_CAN);
    yazi(t"CAN {g_can}", 30, 60, 0.85, BEYAZ);
    int kalan = canli_dusman();
    str hedef_metni = kalan == 0 ? "KAPIYA GIT" : t"dusman {kalan}";
    yazi(t"bolum {g_bolum}   {hedef_metni}   skor {g_skor}", 20, 92, 1.1, SARI);
    yazi("WASD/oklar yuru  SPACE zipla  SHIFT atil  J/sol tik vur  sag tik+surukle ya da Q-E kamera", 20, 122, 0.8, ACIK_GRI);
    if (g_kapi_acik) { yazi(t"kapi acik — {toInt(uzaklik_xz(konum(g_oyuncu), g_kapi))} m", 20, 146, 0.9, RENK_KAPI); }
    if (g_atilma_t > 0.0) { yazi("atilma hazir degil", 20, 170, 0.75, GRI); }
    if (g_hasar_t > 0.0) { dikdortgen(0, 0, genislik(), 6, renk(232, 74, 64)); }
    if (g_yenileme_t > 0.0) { yazi(t"SAHNE YENIDEN YUKLENDI ({g_yenileme})", 20, 196, 1.0, RENK_KAPI); }
    // Dokunmatikte ESC yok: duraklat düğmesi sağ üstte.
    if (g_ekran == Ekran.OYUN && dugme("||", genislik() - ui_px(76), ui_px(14), ui_px(56), ui_px(40))) { g_ekran = Ekran.DURAKLAT; }
    if (g_durum == Durum.AFIS) { yazi(t"BOLUM {g_bolum}", 20, 210, 2.4, BEYAZ); }
    if (g_durum == Durum.SON || g_durum == Durum.KAZANDIN) {
        bool kazandi = g_durum == Durum.KAZANDIN;
        dikdortgen(0, 0, genislik(), yukseklik(), RENK_CAN_ZEMIN);
        yazi(kazandi ? "KAZANDIN" : "OYUN BITTI", 20, 220, 2.6, kazandi ? RENK_KAPI : KIRMIZI);
        str sure = kazandi ? t"   sure {toInt(zaman())} s" : "";
        yazi(t"skor {g_skor}   dusman {g_oldurulen}{sure}", 20, 280, 1.3, BEYAZ);
        yazi(kazandi ? "R: bastan oyna    ESC: cik" : "R: yeniden basla    ESC: cik", 20, 316, 1.0, ACIK_GRI);
    }
}

// ---- Akış -------------------------------------------------------------------
func oyun_karesi(float d) {
    if (g_vurus_t > 0.0) { g_vurus_t -= d; }
    if (g_hasar_t > 0.0) { g_hasar_t -= d; }
    if (g_atilma_t > 0.0) { g_atilma_t -= d; }
    if (g_atilma_kalan > 0.0) { g_atilma_kalan -= d; }
    if (g_serbest_t > 0.0) { g_serbest_t -= d; }
    if (g_durum == Durum.AFIS) {
        g_afis_t -= d;
        if (g_afis_t <= 0.0) { g_durum = Durum.OYNA; }
    }
    if (g_durum == Durum.OYNA) {
        oyuncu_guncelle(d);
        for (int i = 0; i < len(dusmanlar); i++) { dusman_guncelle(i, d); }
        if (bolum_bitti_mi()) {
            if (g_bolum == 1) {
                g_bolum = 2;
                g_gecis_sayisi += 1;
                g_durum = Durum.AFIS;
                g_afis_t = AFIS_SURE;
                g_can = min(OYUNCU_CAN_MAX, g_can + 25);
                logla(t"BOLUM GECISI 1 -> 2 (can {g_can})");
                bolum_kur(2);
            } else {
                g_durum = Durum.KAZANDIN;
                g_rekor = rekor_guncelle("aksiyon_rekor", g_skor);
                logla(t"KAZANDIN — skor {g_skor}, rekor {g_rekor}, sure {zaman()}");
            }
        }
    }
    if (g_durum == Durum.SON && g_rekor < g_skor) { g_rekor = rekor_guncelle("aksiyon_rekor", g_skor); }
}

func main() {
    log_seviyesi(1);
    ayarlari_oku();
    parlama(g_parlama_ayari, 1.0, 0.55);
    if (!motor_ac("Tulpar Engine — Golge Salonlari", 1280, 720)) { print("motor acilamadi: " + eng_last_error()); return; }
    g_kurulum_hatasi_ek = hata_sayisi();
    g_otopilot = eng_headless();
    logla(t"GPU: {eng_gpu_name()} {genislik()}x{yukseklik()}, otopilot {g_otopilot}");
    logla(t"ayarlar: ses {g_ses_ayari}, parlama {g_parlama_ayari} (simdi {parlama_acik()}), rekor {g_rekor} — {kayit_yolu()}");
    if (!g_otopilot) { g_ses_var = ses_ac(); }
    ses_uygula();
    g_can = OYUNCU_CAN_MAX;
    g_durum = Durum.AFIS;
    g_afis_t = AFIS_SURE;
    bolum_kur(1);
    while (calisiyor()) {
        kare_basla();
        float d = dt();
        if (sahne_yenilendi()) {
            g_yenileme += 1;
            g_yenileme_t = 3.0;
            logla(t"SICAK YUKLEME: sahne yenilendi ({sahne_sayisi()} varlik, navmesh {nav_var()})");
        }
        if (g_yenileme_t > 0.0) { g_yenileme_t -= d; }
        if (g_ekran == Ekran.OYUN) { oyun_karesi(d); }
        if (g_ekran == Ekran.MENU) { g_kam_yaw += d * 0.25; } // menüde kamera salonu gezer
        kamera_guncelle(d);
        ui_basla();
        if (g_ekran == Ekran.OYUN || g_ekran == Ekran.DURAKLAT) { hud_ciz(); }
        if (g_ekran == Ekran.MENU) { menu_ciz(); }
        if (g_ekran == Ekran.DURAKLAT) { duraklat_ciz(); }
        if (g_ekran == Ekran.AYAR) { ayar_ciz(); }
        ui_bitir();
        otopilot_menu();
        if ((g_durum == Durum.SON || g_durum == Durum.KAZANDIN) && g_ekran == Ekran.OYUN && tus_basildi("R")) { yeniden_basla(); }
        // ESC: oyunda duraklatır, duraklatta devam, ayarlardan geri, menüde çıkar.
        if (tus_basildi("ESC")) {
            if (g_ekran == Ekran.OYUN) { g_ekran = Ekran.DURAKLAT; }
            else if (g_ekran == Ekran.DURAKLAT) { g_ekran = Ekran.OYUN; }
            else if (g_ekran == Ekran.AYAR) { ayarlari_yaz(); g_ekran = g_ayar_donus; }
            else { ayarlari_yaz(); cikis_iste(); }
        }
        kare_bitir();
    }
    // Skor rekor olarak kalır (pencersiz doğrulama da): kalıcılık böyle ölçülür.
    g_rekor = rekor_guncelle("aksiyon_rekor", g_skor);
    logla(t"bitis: bolum {g_bolum}, skor {g_skor}, oldurulen {g_oldurulen}, can {g_can}, kare {kare_no()}, hata {hata_sayisi()}");
    if (g_ses_var) { ses_kapat(); }
    if (g_otopilot) { kapi_raporu(); }
    motor_kapat();
}

// ============================================================================
// DOĞRULAMA DÜZENİ — oyunun parçası DEĞİL. Pencersiz koşumda (TULPAR_ENGINE_HEADLESS)
// otopilot oyunu kendisi oynar ve sonunda [kapi] satırlarını basar. Motor CI'ı
// .tpr koşturmadığı için dil ve köprü değişikliklerinin oyunu bozmadığını
// yerelde bu ölçer (iki koşum aynı satırı basar: belirlenimli).
// ============================================================================
bool g_otopilot = false;
int g_kurulum_hatasi = 0;     // bölüm kurarken motorun logladığı hata (bozuk blob vb.)
int g_kurulum_hatasi_ek = 0;  // motor kurulumunda (parlama/font)
float g_kayit_ses = -1.0;     // diske yazılan ses ayarı geri okundu
// Menü akışı: adım başına ADIYLA tıklanan widget (1: kaydırıcı, izinin %25'i).
array OP_MENU_ADIM = ["Ayarlar", "Ses seviyesi", "Geri", "Basla"];
int g_op_adim = 0;            // 4 = bitti
// Fren ölçümü: her öldürmeden sonra 0.5 s girdi bırakılır, kayılan yol ölçülür.
float g_op_birak = 0.0;
Vec3 g_op_birak_p = { x: 0.0, y: 0.0, z: 0.0 };
bool g_op_birak_gecerli = false;
int g_op_son_oldurulen = 0;
int g_kayma_olcum = 0;
float g_kayma_max = 0.0;
// Bölüm 1'i temizleyip geçmek k906'da (ölçüldü 2026-09-15); %10 pay.
int KAPI_MIN_KARE = 1000;
// Frensiz (eski) oyuncu 0.5 s'de 2.8 m kayıyordu; frenli ~0.3 m.
float KAYMA_SINIR = 1.0;

// Menüyü BETİK geçer: köprüye tek karelik bas+bırak enjekte edilir, widget
// ADIYLA bulunur. Tıklama bir SONRAKİ karede tüketilir. "Basla" menünün
// çizilmediği karede (ayarlar kapanırken) istenir: kayıt en son yerini tutar.
func otopilot_menu() {
    if (!g_otopilot || g_op_adim >= 4) { return; }
    Ekran gerek = g_op_adim == 0 || g_op_adim == 3 ? Ekran.MENU : Ekran.AYAR;
    if (g_ekran != gerek) { return; }
    if (g_op_adim == 1) { ui_test_tikla_oran(OP_MENU_ADIM[1], 0.25); } else { ui_test_tikla_ad(OP_MENU_ADIM[g_op_adim]); }
    g_op_adim += 1;
}

// En yakın düşmana gider, vurur; düşman kalmadıysa açılan kapıya yürür.
func otopilot(bool yerde_mi, float d) {
    if (g_oldurulen > g_op_son_oldurulen) {
        g_op_son_oldurulen = g_oldurulen;
        g_op_birak = 0.5;
        g_op_birak_p = konum(g_oyuncu);
        g_op_birak_gecerli = true;
    }
    Vec3 sifir = v3(0.0, 0.0, 0.0);
    if (g_op_birak > 0.0) {
        oyuncu_hareket(sifir, false, yerde_mi, d);
        g_op_birak -= d;
        if (g_op_birak <= 0.0 && g_op_birak_gecerli) {
            float kay = uzaklik_xz(g_op_birak_p, konum(g_oyuncu));
            g_kayma_olcum += 1;
            g_kayma_max = max(g_kayma_max, kay);
            logla(t"fren olcumu: girdi birakildi, 0.5 s'de {kay} m kaydi");
        }
        return;
    }
    Vec3 p = konum(g_oyuncu);
    int hedef = -1;
    float en_yakin = 9999.0;
    for (int i = 0; i < len(dusmanlar); i++) {
        if (dusmanlar[i].can <= 0) { continue; }
        float u = uzaklik_xz(p, konum(dusmanlar[i].id));
        if (u < en_yakin) { en_yakin = u; hedef = i; }
    }
    if (hedef < 0 && !g_kapi_acik) { oyuncu_hareket(sifir, false, yerde_mi, d); return; }
    Vec3 t = g_kapi;
    if (hedef >= 0) { t = konum(dusmanlar[hedef].id); }
    Vec3 y = yol_yonu(g_oyuncu, t);
    bool yuruyor = y.x != 0.0 || y.z != 0.0;
    oyuncu_hareket(y, yuruyor, yerde_mi, d);
    if (yuruyor) { g_kam_yaw = g_oyuncu_yaw; }
    if (hedef >= 0 && en_yakin < VURUS_ON + VURUS_R) { vurus_yap(); }
    if (konum_y(g_oyuncu) < -4.0) { dustu(); }
}

func kapi_raporu() {
    // Kalıcılık: depo DİSKTEN tazelenir, bellekteki değerle karşılaştırılır.
    kayit_ac(kayit_yolu());
    g_kayit_ses = kayit_oku_sayi("aksiyon_ses", -1.0);
    int disk_rekor = toInt(kayit_oku_sayi("aksiyon_rekor", -1.0));
    // Oyun DÖNGÜSÜNÜN hatası: kurulum hataları (eksik/bozuk .sahneb) düşülür.
    int hata = hata_sayisi() - g_kurulum_hatasi - g_kurulum_hatasi_ek;
    int kare = kare_no();
    print(t"[kapi] kare={kare} bolum={g_bolum} gecis={g_gecis_sayisi} oldurulen={g_oldurulen} kalan_dusman={canli_dusman()} can={g_can} skor={g_skor} durum={g_durum} navmesh={nav_var()} dongu_hatasi={hata} kurulum_hatasi={g_kurulum_hatasi + g_kurulum_hatasi_ek} uyari={uyari_sayisi()}");
    print(t"[kapi] fren: {g_kayma_olcum} olcum, girdi birakilinca 0.5 s'de en cok {g_kayma_max} m kayma (sinir {KAYMA_SINIR})");
    print(t"[kapi] kayit: dosyadan ses={g_kayit_ses} rekor={disk_rekor} (bellekte ses={g_ses_ayari} rekor={g_rekor})");
    print(t"[kapi] menu: adim={g_op_adim} ui_tik={ui_tiklama()} ekran={g_ekran} ses_ayari={g_ses_ayari} kayitli_ses={g_kayit_ses} rekor={g_rekor} kayit={kayit_yolu()} sahne_yenileme={g_yenileme}");
    // Dikey dilim yalnız bütçe yetiyorsa: pencere açılamayınca köprü 60 karelik
    // yedeğe düşer ve orada 4 düşman + bölüm geçişi yapısal olarak imkânsızdır.
    bool dilim = kare >= KAPI_MIN_KARE;
    if (!dilim) {
        print(t"[kapi] ATLANDI: dikey dilim kapisi >= {KAPI_MIN_KARE} kare ister, bu kosumda {kare} kare var (pencere acilamazsa kopru 60 karelik yedege duser). Tam kapi icin: TULPAR_ENGINE_HEADLESS={KAPI_MIN_KARE} ./tulpar examples/engine_aksiyon.tpr");
    }
    array sorun = [];
    if (hata != 0) { push(sorun, t"oyun dongusu hata sayaci {hata} (0 olmali)"); }
    if (dilim && g_oldurulen < 4) { push(sorun, t"otopilot en az 4 dusman oldurmeliydi, {g_oldurulen}"); }
    if (dilim && g_kayma_olcum < 1) { push(sorun, "fren olcumu hic yapilmadi (darbesiz bir birakma bekleniyordu)"); }
    if (g_kayma_olcum > 0 && g_kayma_max >= KAYMA_SINIR) { push(sorun, t"tus birakilinca oyuncu durmuyor: 0.5 s'de {g_kayma_max} m kaydi (sinir {KAYMA_SINIR})"); }
    if (dilim && g_gecis_sayisi < 1) { push(sorun, "en az bir bolum gecisi bekleniyordu"); }
    if (g_can < 1 || g_can > OYUNCU_CAN_MAX) { push(sorun, t"can araligi disi: {g_can}"); }
    if (g_op_adim < 4) { push(sorun, t"otopilot menu akisini bitirmedi, adim={g_op_adim}"); }
    if (ui_uyari_sayisi() != 0) { push(sorun, t"arayuz yerlesim uyarisi {ui_uyari_sayisi()} (adla tiklama iskasi ya da pencere tasmasi; 0 olmali)"); }
    if (ui_tiklama() < 3) { push(sorun, t"en az 3 arayuz tiklamasi bekleniyordu (Ayarlar/Geri/Basla), {ui_tiklama()}"); }
    if (g_ekran != Ekran.OYUN) { push(sorun, t"menuden oyuna gecilmemis, ekran={g_ekran}"); }
    if (g_ses_ayari < 0.05 || g_ses_ayari > 0.95) { push(sorun, t"kaydirici ses ayarini beklenen aralikta degistirmedi: {g_ses_ayari}"); }
    if (abs(g_kayit_ses - g_ses_ayari) > 0.001) { push(sorun, t"ayar diske yazilip geri okunamadi: {g_kayit_ses} != {g_ses_ayari}"); }
    if (g_rekor < g_skor) { push(sorun, t"rekor skordan kucuk: {g_rekor} < {g_skor}"); }
    // Rekor diske yalnız "skor > eski rekor" iken yazılır: skoru 0 kalan kısa
    // koşumda yazma beklenmez (dosya boş, okuma -1 döner).
    if (g_rekor > 0 && disk_rekor != g_rekor) { push(sorun, t"rekor diske yazilmamis: dosyada {disk_rekor}, bellekte {g_rekor}"); }
    for (s in sorun) { print("[kapi] BASARISIZ: " + s); }
    if (len(sorun) > 0) { exit(1); }
    print(dilim ? "[kapi] TAMAM — dikey dilim pencersiz kostu, olculen sayilar araliginda"
                : "[kapi] TAMAM (yalniz kabuk kapisi: menu akisi, arayuz tiklamalari, ayar kaliciligi) — dikey dilim ATLANDI");
}

main();
