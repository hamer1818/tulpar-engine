// Tulpar Engine — yerel ağ (UDP, eng_net_*) İKİ SÜREÇ ölçüsü: gidiş-dönüş süresi (N2a).
// Oyun değil, ölçü. Motor KURULMAZ (ağ kurulumsuz çalışır).
//
//   cd tulpar
//   TULPAR_AG_ROL=yanit TULPAR_AG_PORT=47400 tulpar examples/engine_ag_ping.tpr &
//   TULPAR_AG_ROL=ping  TULPAR_AG_PORT=47401 TULPAR_AG_KARSI=47400 tulpar examples/engine_ag_ping.tpr
//
// ping N paket ("ping <i> <t>") gönderir, her birinin yanıtını ("pong <i> <t>") bekler ve
// gidiş-dönüşü clock_ms ile ölçer. TULPAR_AG_KARE_MS=16: iki taraf da paketi yalnız kare
// başında yoklar (oyunun kare döngüsü gibi, sleep ile) — ölçülen süre taşıma değil kare
// temposu olur. 0 (varsayılan): sıkı yoklama, yani köprü + çekirdek taşıma süresi.
// Ortam: TULPAR_AG_N (200), TULPAR_AG_IP (127.0.0.1), TULPAR_AG_ZAMAN_ASIMI_MS (500 / paket).
// Çıkış: "[ag] ping N/N, kayip K, rtt p50 .. p95 .. max .. ms" ve rc 0 (kayıp 0 ise).
import "engine";

func ortam_int(str ad, int vars): int {
    str v = env(ad);
    if (len(v) == 0) { return vars; }
    return toInt(v);
}
func ortam_str(str ad, str vars): str {
    str v = env(ad);
    if (len(v) == 0) { return vars; }
    return v;
}

// Bir paket gelene kadar (ya da zaman aşımına kadar) yoklar. kare_ms > 0: kare temposu.
func paket_bekle(int h, float sinir_ms, int kare_ms): bool {
    float t0 = clock_ms();
    while (clock_ms() - t0 < sinir_ms) {
        if (udp_al(h)) { return true; }
        if (kare_ms > 0) { sleep(kare_ms); }
    }
    return false;
}

func yanitla(int h, int kare_ms): int {
    int n = 0;
    float son = clock_ms();
    // Ping 5 sn sessiz kalırsa (ya da "son" gelirse) biter.
    while (clock_ms() - son < 5000.0) {
        if (paket_bekle(h, 100.0, kare_ms)) {
            str y = udp_son_yuk(h);
            son = clock_ms();
            if (y == "son") {
                print("[ag] yanit: " + toString(n) + " paket yanitlandi, son geldi");
                return 0;
            }
            str[] p = split(y, " ");
            if (len(p) == 3 && p[0] == "ping") {
                udp_gonder(h, udp_son_ip(h), udp_son_port(h), "pong " + p[1] + " " + p[2]);
                n = n + 1;
            }
        }
    }
    print("[ag] yanit: 5 sn sessizlik, " + toString(n) + " paket yanitlandi");
    return 1;
}

func ping(int h, str ip, int karsi, int n, float sinir_ms, int kare_ms): int {
    float[] rtt = [];
    int kayip = 0;
    int bozuk = 0;
    for (int i = 0; i < n; i++) {
        float t0 = clock_ms();
        udp_gonder(h, ip, karsi, "ping " + toString(i) + " " + toString(t0));
        bool geldi = false;
        while (!geldi && clock_ms() - t0 < sinir_ms) {
            if (paket_bekle(h, sinir_ms - (clock_ms() - t0), kare_ms)) {
                str[] p = split(udp_son_yuk(h), " ");
                if (len(p) == 3 && p[0] == "pong" && toInt(p[1]) == i) {
                    push(rtt, clock_ms() - t0);
                    geldi = true;
                } else {
                    bozuk = bozuk + 1; // geç gelen eski yanıt ya da yabancı paket
                }
            }
        }
        if (!geldi) { kayip = kayip + 1; }
    }
    udp_gonder(h, ip, karsi, "son");
    // Yerinde sıralama (n küçük): yüzdelikler.
    int m = len(rtt);
    for (int i = 1; i < m; i++) {
        float v = rtt[i];
        int j = i - 1;
        while (j >= 0 && rtt[j] > v) {
            rtt[j + 1] = rtt[j];
            j = j - 1;
        }
        rtt[j + 1] = v;
    }
    if (m == 0) {
        print("[ag] ping 0/" + toString(n) + ", kayip " + toString(kayip) + " — hic yanit yok");
        return 1;
    }
    float p50 = rtt[m / 2];
    float p95 = rtt[(m * 95) / 100];
    float en = rtt[m - 1];
    print("[ag] ping " + toString(m) + "/" + toString(n) + ", kayip " + toString(kayip) + ", bozuk " + toString(bozuk)
        + ", kare " + toString(kare_ms) + " ms, rtt p50 " + toString(p50) + " p95 " + toString(p95) + " max "
        + toString(en) + " ms (gonderilen " + toString(udp_sayac(1)) + ", alinan " + toString(udp_sayac(2)) + ")");
    if (kayip > 0) { return 1; }
    return 0;
}

func main() {
    str rol = ortam_str("TULPAR_AG_ROL", "ping");
    int port = ortam_int("TULPAR_AG_PORT", 0);
    int kare_ms = ortam_int("TULPAR_AG_KARE_MS", 0);
    int h = udp_ac(port, false);
    if (h == 0) {
        print("[ag] HATA: port " + toString(port) + " acilamadi");
        exit(2);
    }
    print("[ag] " + rol + ": port " + toString(udp_port(h)) + ", yerel ip '" + udp_yerel_ip() + "'");
    int rc = 0;
    if (rol == "yanit") {
        rc = yanitla(h, kare_ms);
    } else {
        rc = ping(h, ortam_str("TULPAR_AG_IP", "127.0.0.1"), ortam_int("TULPAR_AG_KARSI", 47400), ortam_int("TULPAR_AG_N", 200),
            toFloat(ortam_int("TULPAR_AG_ZAMAN_ASIMI_MS", 500)), kare_ms);
    }
    udp_kapat(h);
    exit(rc);
}
main();
