// Tulpar Engine — betik YAŞAM DÖNGÜSÜ: motor atanan `.tpr`'yi çalıştırır.
//
//   engine_editor --scene examples/assets/betik_dagitimi.sahne   # düzenle; F5 bu oyunu
//                                                                # editörün Oyun sekmesinde oynatır
//   engine_sahnec examples/assets/betik_dagitimi.sahne           # -> .sahneb
//   ./tulpar examples/engine_betik_dagitimi.tpr                  # oyna (kendi penceresi)
//
// Pencersiz doğrulama:
//   TULPAR_ENGINE_HEADLESS=180 TULPAR_ENGINE_OUT=/tmp/bd.ppm ./tulpar examples/engine_betik_dagitimi.tpr
//
// ---------------------------------------------------------------------------
// DAĞITIM KODU BU DOSYADA YOK ve olayın tamamı bu. Sahnede bir nesneye
// `betik "tulpar/examples/davranis/kovala.tpr"` atandığında motor, dosya adının tabanından
// türeyen fonksiyonları kendisi çözüp çağırıyor:
//
//   kovala_baslat(id)                            sahne yüklenince bir kez
//   kovala_guncelle(id, dt)                      her kare, fizik adımından SONRA
//   kovala_carpisma(id, diger, olay, x,y,z, hiz) her çarpışma olayı için
//   kovala_bitir(id)                             sahne boşalırken / kapanışta
//
// Dördü de isteğe bağlı; motor hangisi varsa onu çağırır. Tetik hacimleri
// (bölgeler) için iki kanca daha var: bölgenin betiğinde <ad>_tetik_girdi /
// _tetik_cikti, girenin betiğinde <ad>_bolge_girdi / _bolge_cikti — bu
// sahnede "alarm_bolgesi" oyuncuyu, "gecit" devriyenin yolunu kapsıyor.
// "nobetci" bir SAHNE KARAKTERİ (Karakter Kontrolcüsü bileşeni): betiği onu
// `sahne_karakter_yuru` ile "kule" bölgesinin içinden gidip getiriyor.
//
// Oyun döngüsünde tek bir `if betik == "..."` satırı yok. Yeni bir davranış
// eklemek = `davranis/` altına bir dosya koymak + onu import etmek.
//
// AOT SINIRI — DİKKAT: Tulpar'da yorumlayıcı yok, yani bir betik ancak oyunun
// İKİLİSİNE DERLENMİŞSE çalışır. Aşağıdaki `import` satırları tam olarak bunu
// yapıyor. Tasarımcı editörde import edilmemiş bir betik atarsa motor yükleme
// anında GÖRÜNÜR hata basar ("oyun bu dosyayı import etti mi?") — nesne
// sessizce hareketsiz kalmaz.
// ---------------------------------------------------------------------------
//
// Not: test koşucusunda derlenir, çalıştırılmaz (pencere/GPU ister).

import "engine";
import "examples/davranis/kovala.tpr";
import "examples/davranis/devriye.tpr";
import "examples/davranis/alarm.tpr";
import "examples/davranis/nobet.tpr";

func main() {
    log_seviyesi(2);
    if (!motor_ac("Tulpar Engine — betik yasam dongusu", 1280, 720)) {
        print("motor acilamadi: " + eng_last_error());
        return;
    }
    gunes(0.45, 1.0, 0.3, 0.95);
    ortam(renk(36, 39, 48));
    golge_hacmi(0, 1, 0, 16, 50);

    if (!sahne_yukle("examples/assets/betik_dagitimi.sahneb")) {
        print("sahne yok — once: engine_sahnec examples/assets/betik_dagitimi.sahne");
        motor_kapat();
        return;
    }
    sahne_izle(true);

    while (calisiyor()) {
        if (kare_basla()) {
            yazi("Betik yasam dongusu: turuncu kovalar, mavi devriye gezer, sari nobetci (sahne karakteri) kuleden gecer", 12, 12, 1.0, renk(235, 238, 245));
        }
        // Sıcak yükleme: editörde "Derle" -> blob değişir -> motor kancaları
        // YENİDEN çözer. Oyunun yapacağı bir şey yok; tablo motorda.
        if (sahne_yenilendi()) { logla("sahne yenilendi -> kancalar yeniden cozuldu"); }
        kare_bitir();
    }
    motor_kapat();
}

main();
