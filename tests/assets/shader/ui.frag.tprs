// kaynak-ozet: 6b61c4f606ef  (engine/rhi/shaders/ui.frag)
// 2B arayuz parcasi: sRGB algisal renk -> dogrusal, atlas ile carpim.
str asama = "frag";

vec2 v_uv = girdi(0);
vec4 v_color = girdi(1);
float v_encode = girdi_duz(2);

sampler2D u_atlas = ornek(1, 0);

vec4 o_color = cikti(0);

func srgb_to_linear(vec3 c): vec3 {
  return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(0.04045, c));
}
func linear_to_srgb(vec3 c): vec3 {
  c = clamp(c, 0.0, 1.0);
  return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(0.0031308, c));
}
// v_encode = kodla (0/1) + 2 * titret (E1c). Titretme alfayi +-0.5/255 oynatir
// (Jimenez 2014 IGN, ekran pikseline bagli); alfa 0 olan piksele dokunmaz.
func ign(vec2 p): float {
  return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
}
func main() {
  vec4 c = vec4(srgb_to_linear(v_color.rgb), v_color.a) * texture(u_atlas, v_uv);
  if (v_encode > 1.5 && c.a > 0.0) { c.a = clamp(c.a + (ign(gl_FragCoord.xy) - 0.5) / 255.0, 0.0, 1.0); }
  if (mod(v_encode, 2.0) > 0.5) { c.rgb = linear_to_srgb(c.rgb); }
  o_color = c;
}
