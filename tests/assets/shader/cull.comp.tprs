// kaynak-ozet: 58e06d03835f  (engine/rhi/shaders/cull.comp)
// GPU frustum ayiklama + sikistirma: is grubu = (parti, frustum). Her parti
// icin dolayli cizim komutu (5 uint) ve gorunur cizim listesi; sikistirma
// paylasimli bellekte onek toplami (Hillis-Steele) ile, atomik yok.
// T20: compute asamasi — is_grubu() / paylasimli() isaretleri.
str asama = "comp";

uvec3 grup = is_grubu(64);

struct DrawItem {
  mat4 model;
  vec4 color;
  vec4 sphere; // yerel merkez.xyz + yerel yaricap
  uvec4 misc;
}
struct Batch {
  uint first_draw;
  uint draw_count;
  uint index_count;
  uint first_index;
  int vertex_offset;
  uint pad0;
  uint pad1;
  uint pad2;
}

struct Draws { DrawItem[] d; }
Draws u_draws = depo(0, 0);
struct Batches { Batch[] b; }
Batches u_batches = depo(0, 1);
struct Frusta { vec4[] plane; }
Frusta u_frusta = depo(0, 2); // frustum basina 6
struct Cmds { uint[] c; }
Cmds u_cmd = depo_yaz(0, 3);
struct Visible { uint[] v; }
Visible u_vis = depo_yaz(0, 4);

struct Push { uvec4 counts; }
Push pc = itme();

uint[64] s_flag = paylasimli();
uint s_base = paylasimli();

func main() {
  uint bi = gl_WorkGroupID.x;
  uint fi = gl_WorkGroupID.y;
  if (bi >= pc.counts.x || fi >= pc.counts.y) { return; }
  uint tid = gl_LocalInvocationID.x;
  Batch B = u_batches.b[bi];
  uint cmd = (fi * pc.counts.z + bi) * 5u;
  if (tid == 0u) {
    s_base = 0u;
    u_cmd.c[cmd + 0u] = B.index_count;
    u_cmd.c[cmd + 2u] = B.first_index;
    u_cmd.c[cmd + 3u] = u32(B.vertex_offset);
    u_cmd.c[cmd + 4u] = 0u;
  }
  barrier();
  uint vbase = fi * pc.counts.w + B.first_draw;
  for (uint chunk = 0u; chunk < B.draw_count; chunk += 64u) {
    uint i = chunk + tid;
    uint vis = 0u;
    if (i < B.draw_count) {
      DrawItem D = u_draws.d[B.first_draw + i];
      vec3 c = (D.model * vec4(D.sphere.xyz, 1.0)).xyz;
      float sx = length(D.model[0].xyz);
      float sy = length(D.model[1].xyz);
      float sz = length(D.model[2].xyz);
      float r = D.sphere.w * max(sx, max(sy, sz));
      vis = 1u;
      for (uint k = 0u; k < 6u; k++) {
        vec4 p = u_frusta.plane[fi * 6u + k];
        if (dot(p.xyz, c) + p.w < -r) {
          vis = 0u;
          break;
        }
      }
    }
    s_flag[tid] = vis;
    barrier();
    for (uint off = 1u; off < 64u; off <<= 1) {
      uint add = (tid >= off) ? s_flag[tid - off] : 0u;
      barrier();
      s_flag[tid] += add;
      barrier();
    }
    if (vis == 1u) { u_vis.v[vbase + s_base + s_flag[tid] - 1u] = B.first_draw + i; }
    barrier();
    if (tid == 63u) { s_base += s_flag[63u]; }
    barrier();
  }
  if (tid == 0u) { u_cmd.c[cmd + 1u] = s_base; }
}
