// kaynak-ozet: aa0ae2ffb4f7  (engine/rhi/shaders/vsm_mark.comp)
// VSM sayfa isaretleme (Faz 9, 2026-11-23): her piksel derinliginden dunya konumu geri kurulur, clipmap seviyesi
// kameraya uzakliktan secilir ve MUTLAK isik-uzayi izgarasindaki sayfa anahtari yazilir. CPU basvurusu:
// renderer::vsm_mark_from_depth (ayni formul) — GPU kapisi anahtar kumelerini karsilastirir. Tekillestirme simdilik CPU'da.
str asama = "comp";

uvec3 grup = is_grubu(8, 8);

struct Push {
  mat4 inv_vp;
  vec4 lu;   // xyz: isik u ekseni, w: seviye 0 sayfa kenari (m)
  vec4 lv;   // xyz: isik v ekseni, w: seviye 0 uzakligi (m)
  vec4 cam;  // xyz: kamera, w: seviye sayisi
  uvec4 dims; // x: genislik, y: yukseklik
}
Push pc = itme();

struct Depth { float[] d; }
Depth u_depth = depo(0, 0);
struct Keys { ivec4[] k; }
Keys u_keys = depo_yaz(0, 1);

func main() {
  uvec2 p = gl_GlobalInvocationID.xy;
  if (p.x >= pc.dims.x || p.y >= pc.dims.y) { return; }
  uint i = p.y * pc.dims.x + p.x;
  float d = u_depth.d[i];
  if (d >= 1.0) {
    u_keys.k[i] = ivec4(0, 0, 0, 0);
    return;
  }
  vec2 ndc = (vec2(p) + 0.5) / vec2(pc.dims.xy) * 2.0 - 1.0;
  vec4 c = pc.inv_vp * vec4(ndc, d, 1.0);
  vec3 w = c.xyz / c.w;
  float dist = length(w - pc.cam.xyz);
  uint levels = u32(pc.cam.w);
  uint l = 0u;
  float lim = pc.lv.w;
  while (dist > lim && l + 1u < levels) {
    lim = lim * 2.0;
    l = l + 1u;
  }
  float pw = pc.lu.w * f32(1u << l);
  u_keys.k[i] = ivec4(i32(l), i32(floor(dot(w, pc.lu.xyz) / pw)), i32(floor(dot(w, pc.lv.xyz) / pw)), 1);
}
