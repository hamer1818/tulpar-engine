// kaynak-ozet: 8f68d5d88972  (engine/rhi/shaders/triangle.vert)
// Faz 1 ilk piksel: vertex buffer yok, uc kose gl_VertexIndex'ten.
// Vulkan NDC: y asagi; (0,-0.6) ust kose. z=0.5 -> depth prepass yazar.
// T9: Tulpar dizi literali `[...]` + G3 onek boy `vec2[3]` -> GLSL dizi kurucusu.
str asama = "vert";

vec3 v_color = cikti(0);

func main() {
  const vec2[3] pos = [vec2(-0.6, 0.6), vec2(0.6, 0.6), vec2(0.0, -0.6)];
  gl_Position = vec4(pos[gl_VertexIndex], 0.5, 1.0);
  v_color = vec3(1.0, 0.5, 0.0);
}
